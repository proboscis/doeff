"""Types of hy.models (declarations for type checking — at runtime hy/models.py is read; the stub for the part doeff-hy distributes).

Hy expansion compiles keyword literals and quoted forms into `hy.models.Keyword("x")` and `hy.models.Expression([...])`, and
doeff-hy-check puts `import hy.models` in modules that read them. hy ships no type declarations, so strict
reportMissingTypeStubs was raised on that import. The model types are declared here.

Sequence elements are object — the elements of sequences made by the reader and quote are models, but sequences built by macros also contain non-model values (str, None)
(as_model wraps them later), and the constructor accepts any value. Places that use an element as a model narrow it with isinstance.
"""

from collections.abc import Iterable, Iterator, Mapping
from contextlib import AbstractContextManager
from typing import ClassVar, Self, SupportsIndex, TypeVar, overload

_V = TypeVar("_V")
_D = TypeVar("_D")

PRETTY: bool

def pretty(pretty: bool = True) -> AbstractContextManager[None]: ...

class Object:
    """Abstract base of Hy models (forms). Positions are 1-based and inclusive of both ends (1 if absent)."""

    properties: ClassVar[list[str]]
    start_line: int
    start_column: int
    end_line: int
    end_column: int
    def replace(self, other: Object, recursive: bool = False) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

def as_model(x: object) -> Object: ...
def replace_hy_obj(obj: object, other: Object) -> Object: ...
def repr_indent(obj: object) -> str: ...
def is_unpack(kind: str, x: object) -> bool: ...

class String(Object, str):
    __match_args__ = ("_as_str",)
    brackets: str | None
    def __new__(cls, s: str = ..., brackets: str | None = None) -> Self: ...
    def __add__(self, other: str) -> Self: ...
    @property
    def _as_str(self) -> str: ...

class Bytes(Object, bytes):
    __match_args__ = ("_as_bytes",)
    @property
    def _as_bytes(self) -> bytes: ...

class Symbol(Object, str):
    __match_args__ = ("_as_str",)
    def __new__(cls, s: object, from_parser: bool = False) -> Self: ...
    @property
    def _as_str(self) -> str: ...

class Keyword(Object):
    __match_args__ = ("name",)
    name: str
    def __init__(self, value: object, from_parser: bool = False) -> None: ...
    def __lt__(self, other: Keyword) -> bool: ...
    def __le__(self, other: Keyword) -> bool: ...
    def __gt__(self, other: Keyword) -> bool: ...
    def __ge__(self, other: Keyword) -> bool: ...
    def __bool__(self) -> bool: ...
    @overload
    def __call__(self, data: Mapping[str, _V]) -> _V: ...
    @overload
    def __call__(self, data: Mapping[str, _V], default: _D) -> _V | _D: ...

class Integer(Object, int):
    __match_args__ = ("_as_int",)
    def __new__(cls, number: int | str) -> Self: ...
    @property
    def _as_int(self) -> int: ...

class Float(Object, float):
    __match_args__ = ("_as_float",)
    def __new__(cls, num: float | str) -> Self: ...
    @property
    def _as_float(self) -> float: ...

class Complex(Object, complex):
    __match_args__ = ("real", "imag")
    def __new__(cls, real: complex | str, imag: float = 0) -> Self: ...

class Sequence(Object, tuple[object, ...]):
    """Abstract base of sequence-shaped models (indexable, iterable and supports + like a tuple; elements cannot be rewritten)."""

    def __new__(cls, iterable: Iterable[object] = ...) -> Self: ...
    def replace(self, other: Object, recursive: bool = True) -> Self: ...
    # + returns a sequence of the left type (also accepts a list on the right — Sequence.__add__ in hy/models.py).
    def __add__(self, other: tuple[object, ...] | list[object]) -> Self: ...
    @overload
    def __getitem__(self, item: SupportsIndex) -> object: ...
    @overload
    def __getitem__(self, item: slice) -> Self: ...

class FComponent(Sequence):
    conversion: str | None
    expression: str | None
    is_tstring: bool
    def __new__(
        cls,
        s: Iterable[object] = ...,
        conversion: str | None = None,
        expression: str | None = None,
        is_tstring: bool = False,
    ) -> Self: ...

class FString(Sequence):
    brackets: str | None
    is_tstring: bool
    def __new__(cls, s: Iterable[object] = ..., brackets: str | None = None, is_tstring: bool = False) -> Self: ...

class List(Sequence): ...

class Dict(Sequence):
    def keys(self) -> list[object]: ...
    def values(self) -> list[object]: ...
    def items(self) -> list[tuple[object, object]]: ...

class Expression(Sequence): ...
class Set(Sequence): ...
class Tuple(Sequence): ...

class Lazy(Object):
    """The answer of hy.read-many — an iterator that reads forms one at a time."""

    def __init__(self, gen: Iterator[Object]) -> None: ...
    def __iter__(self) -> Iterator[Object]: ...
    def __next__(self) -> Object: ...
