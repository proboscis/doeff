+
+package runc
+
+import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/containerd/cgroups/v3"
+	cgroupsv2 "github.com/containerd/cgroups/v3/cgroup2"
+)
+
+const cgroupV2Root = "/sys/fs/cgroup"
+
+// processCgroupDir returns the cgroup v2 directory of pid, or "" on cgroup v1
+// or when it cannot be read.
+func processCgroupDir(pid int) string {
+	if cgroups.Mode() != cgroups.Unified {
+		return ""
+	}
+	g, err := cgroupsv2.PidGroupPath(pid)
+	if err != nil {
+		return ""
+	}
+	return filepath.Join(cgroupV2Root, g)
+}
+
+// limitOOMCount sums the local "oom" count (memory.events.local) of dir and of
+// each of its ancestors below the cgroup v2 root. The kernel adds to the local
+// "oom" count of the cgroup whose memory limit was hit, so the sum grows when a
+// limit at the container's cgroup or above it is hit, and does not grow when
+// only a limit on a cgroup nested inside the container is hit.
+func limitOOMCount(dir string) uint64 {
+	return limitOOMCountUnder(cgroupV2Root, dir)
+}
+
+func limitOOMCountUnder(root, dir string) uint64 {
+	var sum uint64
+	for d := filepath.Clean(dir); strings.HasPrefix(d, root+"/"); d = filepath.Dir(d) {
+		sum += localOOM(d)
+	}
+	return sum
+}
+
+func localOOM(dir string) uint64 {
+	f, err := os.Open(filepath.Join(dir, "memory.events.local"))
+	if err != nil {
+		return 0
+	}
+	defer f.Close()
+	s := bufio.NewScanner(f)
+	for s.Scan() {
+		name, value, ok := strings.Cut(s.Text(), " ")
+		if ok && name == "oom" {
+			n, _ := strconv.ParseUint(strings.TrimSpace(value), 10, 64)
+			return n
+		}
+	}
+	return 0
+}
