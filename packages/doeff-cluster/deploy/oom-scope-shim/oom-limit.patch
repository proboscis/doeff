+package runc
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeLocalEvents(t *testing.T, dir string, oom int) {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	body := fmt.Sprintf("low 0\nhigh 0\nmax 3\noom %d\noom_kill 0\noom_group_kill 0\n", oom)
+	if err := os.WriteFile(filepath.Join(dir, "memory.events.local"), []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestLimitOOMCountCountsContainerAndAncestorsOnly(t *testing.T) {
+	root := t.TempDir()
+	pod := filepath.Join(root, "kubepods.slice", "kubepods-pod1.slice")
+	scope := filepath.Join(pod, "cri-containerd-abc.scope")
+	layer := filepath.Join(scope, "exec")
+	writeLocalEvents(t, filepath.Join(root, "kubepods.slice"), 0)
+	writeLocalEvents(t, pod, 1)
+	writeLocalEvents(t, scope, 2)
+	writeLocalEvents(t, layer, 7)
+	// root itself is not read (the cgroup v2 root has no memory.events.local).
+	writeLocalEvents(t, root, 100)
+
+	if got := limitOOMCountUnder(root, scope); got != 3 {
+		t.Fatalf("limitOOMCountUnder(scope) = %d, want 3 (scope 2 + pod 1, not the nested layer)", got)
+	}
+	writeLocalEvents(t, layer, 8)
+	if got := limitOOMCountUnder(root, scope); got != 3 {
+		t.Fatalf("an OOM under the nested layer's limit changed the count to %d", got)
+	}
+	writeLocalEvents(t, pod, 2)
+	if got := limitOOMCountUnder(root, scope); got != 4 {
+		t.Fatalf("an OOM under the pod's limit left the count at %d, want 4", got)
+	}
+}
+
+func TestLimitOOMCountMissingFilesCountZero(t *testing.T) {
+	root := t.TempDir()
+	if got := limitOOMCountUnder(root, filepath.Join(root, "gone.scope")); got != 0 {
+		t.Fatalf("got %d, want 0", got)
+	}
+}
