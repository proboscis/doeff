# 導いた物 — ../../disk-share/derive.py が ../../disk-share/shares.yaml の atlas の分け前から書く(手で直さない)。
# 機体 atlas の上で k8s の外で動く worker atlas-native の空きの最低と roots の上限(boot.sh が GiB の整数で読む)。
# 読み手 = 機体直の worker の起動 script(unit の env が この file の path を名指す)。空きの最低は同じ根の disk の Pod の worker と同じ値。
WORKER_ENV_MIN_FREE_GIB=20
WORKER_ENV_ROOTS_GIB=3
