# 内側の Rust の拡張 doeff_indexer._native(src/python_api.rs)の型。利用者は入口の FindSymbols と rust_indexer で引く。
from typing import Literal

class SymbolInfo:
    @property
    def name(self) -> str: ...
    @property
    def module_path(self) -> str: ...
    @property
    def full_path(self) -> str: ...
    @property
    def symbol_type(self) -> Literal["function", "async_function", "variable"]: ...
    @property
    def tags(self) -> list[str]: ...
    @property
    def line_number(self) -> int: ...
    @property
    def file_path(self) -> str: ...

class Indexer:
    @staticmethod
    def for_module(module_path: str) -> Indexer: ...
    def find_symbols(self, tags: list[str], symbol_type: str | None) -> list[SymbolInfo]: ...
    def get_module_hierarchy(self) -> list[str]: ...
    def find_in_module(self, module: str, tags: list[str]) -> list[SymbolInfo]: ...
