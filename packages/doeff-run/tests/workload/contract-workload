#!/bin/sh
# 契約の負荷(tests/workloads.hy の約束)。container の PID 1 で走るので、合図(SIGTERM)への応じ方を自分で決める
# (PID 1 は handler を置かない合図を受けない)。
case "$1" in
  live)
    trap 'exit 143' TERM
    while :; do sleep 1 & wait $!; done
    ;;
  exits)
    sleep "$3"
    exit "$2"
    ;;
  stubborn)
    trap '' TERM
    while :; do sleep 1 & wait $!; done
    ;;
  hog)
    # 文字列を倍々に伸ばしてメモリの上限を越える(PID 1 の sh 自身が OOM で殺される)。
    x=a
    while :; do x="$x$x"; done
    ;;
  *)
    echo "contract-workload: 種類を知らない: $1" >&2
    exit 64
    ;;
esac
