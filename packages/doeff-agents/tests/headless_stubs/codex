#!/usr/bin/env python3
"""codex app-server(JSON-RPC over stdio・schema v2)の替え玉 — 検の PATH に置く。

initialize / thread/start / thread/resume / turn/start / turn/interrupt に実物と同じ形で
答え、手番の実況(turn/started・item/agentMessage/delta・item/completed・
thread/tokenUsage/updated・turn/completed)を流す。DOEFF_HEADLESS_STUB_DELAY 秒だけ
turn/completed の前で待つ(その間の turn/interrupt で status interrupted)。API は撃かない。
DOEFF_HEADLESS_STUB_ASK=1 なら手番の途中で server → client の要求(item/tool/requestUserInput)
を 1 つ投げる(断られる方の検)。

この Mac の PATH の codex は dotfiles の router shim(agentcli/codex_shim.py)で、sandbox /
approval の旗を政策違反として exit 2 で拒む(2026-09-12 の本番の実弾: `--yolo` で
`process exited with code 2 before the turn ended`)。替え玉も同じ綴りを同じ形で拒む —
shim の _is_forbidden_override の写し(module は import しない)。
"""
import json
import os
import sys
import threading

SHIM_FORBIDDEN_FLAGS = ("-s", "--sandbox", "-a", "--full-auto", "--yolo")
SHIM_FORBIDDEN_PREFIXES = ("--sandbox=", "-s=", "--ask-for-approval=", "-a=")
SHIM_FORBIDDEN_CONFIG_KEYS = (
    "sandbox_mode=", "sandbox_permissions=", "sandbox_workspace_write.", "approval_policy=",
)
SHIM_REFUSAL = ("codex-router: sandbox and approval overrides are forbidden; "
                "Codex must run unsandboxed with approval policy never")


def refuse_like_the_router_shim(args):
    """shim と同じ拒否: 禁止の旗 / `-c` の直後の sandbox・approval の本文があれば exit 2。"""
    after_config = False
    for arg in args:
        body = arg
        for prefix in ("--config=", "-c="):
            if arg.startswith(prefix):
                body = arg[len(prefix):]
                break
        if (arg in SHIM_FORBIDDEN_FLAGS or arg.startswith(SHIM_FORBIDDEN_PREFIXES)
                or body.startswith(SHIM_FORBIDDEN_CONFIG_KEYS)
                or (after_config and arg.startswith(SHIM_FORBIDDEN_CONFIG_KEYS))):
            sys.stderr.write(SHIM_REFUSAL + "\n")
            sys.stderr.flush()
            sys.exit(2)
        after_config = arg in ("-c", "--config")


def _emit(obj):
    with EMIT_LOCK:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


EMIT_LOCK = threading.Lock()
INTERRUPT = threading.Event()
TURN_COUNTER = [0]


DATA_URL_PREFIX = "data:"


def _turn_input_text(items):
    """段 10 lane 10o(実測 2026-09-14・conformance/attachment-physics.md): turn/start の input の項の綴りを凍結する。

    受けるのは ``{"type":"text","text":…}`` と ``{"type":"image","url":"data:<mime>;base64,<data>"}`` ちょうど
    (実測: data URL と localImage は API へ同じ input_image になる)。綴りの違う項は **RuntimeError** で落とす:
    実物は黙って劣化する(turn は completed のまま画像を読まない)ので、替え玉が誤綴りを検で赤にする。
    戻り = 本文 + 見た画像の印(検が「model が画像を受け取った」ことを読める形)。
    """
    if not isinstance(items, list):
        return ""
    said = []
    for item in items:
        if not isinstance(item, dict):
            raise RuntimeError(f"turn input item must be an object: {item!r}")
        kind = item.get("type")
        if kind == "text":
            said.append(str(item.get("text", "")))
            continue
        if kind != "image":
            raise RuntimeError(f"unknown turn input item type: {kind!r}")
        url = item.get("url")
        if not (isinstance(url, str) and url.startswith(DATA_URL_PREFIX) and ";base64," in url):
            raise RuntimeError(f"image item needs a base64 data URL in `url`: {item!r}")
        mime = url[len(DATA_URL_PREFIX):url.index(";base64,")]
        data = url[url.index(";base64,") + len(";base64,"):]
        if not (mime and data):
            raise RuntimeError(f"image data URL needs a mime and a payload: {url!r}")
        said.append(f"[saw {mime} {len(data)}b]")
    return " ".join(part for part in said if part)


def run_turn(thread_id, turn_id, text):
    _emit({"jsonrpc": "2.0", "method": "turn/started",
           "params": {"threadId": thread_id, "turn": {"id": turn_id}}})
    item_id = f"item-{turn_id}"
    _emit({"jsonrpc": "2.0", "method": "item/started",
           "params": {"threadId": thread_id, "turnId": turn_id,
                      "item": {"id": item_id, "type": "agentMessage", "text": ""}}})
    for piece in (text[:5], text[5:]):
        _emit({"jsonrpc": "2.0", "method": "item/agentMessage/delta",
               "params": {"threadId": thread_id, "turnId": turn_id, "itemId": item_id,
                          "delta": piece}})
    if os.environ.get("DOEFF_HEADLESS_STUB_ASK") == "1":
        _emit({"jsonrpc": "2.0", "id": "srv-1", "method": "item/tool/requestUserInput",
               "params": {"threadId": thread_id, "turnId": turn_id, "itemId": "q-1"}})
    delay = float(os.environ.get("DOEFF_HEADLESS_STUB_DELAY", "0") or "0")
    if delay and INTERRUPT.wait(delay):
        _emit({"jsonrpc": "2.0", "method": "turn/completed",
               "params": {"threadId": thread_id,
                          "turn": {"id": turn_id, "status": "interrupted"}}})
        return
    if INTERRUPT.is_set():
        _emit({"jsonrpc": "2.0", "method": "turn/completed",
               "params": {"threadId": thread_id,
                          "turn": {"id": turn_id, "status": "interrupted"}}})
        return
    _emit({"jsonrpc": "2.0", "method": "item/completed",
           "params": {"threadId": thread_id, "turnId": turn_id,
                      "item": {"id": item_id, "type": "agentMessage", "text": text}}})
    _emit({"jsonrpc": "2.0", "method": "item/completed",
           "params": {"threadId": thread_id, "turnId": turn_id,
                      "item": {"id": f"cmd-{turn_id}", "type": "commandExecution",
                               "command": "echo hi", "aggregatedOutput": "hi\n",
                               "exitCode": 0, "status": "completed"}}})
    _emit({"jsonrpc": "2.0", "method": "thread/tokenUsage/updated",
           "params": {"threadId": thread_id,
                      "tokenUsage": {"total": {"inputTokens": 11, "cachedInputTokens": 4,
                                               "cacheWriteInputTokens": 0,
                                               "outputTokens": 5}}}})
    _emit({"jsonrpc": "2.0", "method": "turn/completed",
           "params": {"threadId": thread_id, "turn": {"id": turn_id, "status": "completed"}}})


def main():
    args = sys.argv[1:]
    if "--help" in args:
        sys.stdout.write("stub codex\n")
        return 0
    refuse_like_the_router_shim(args)
    thread_id = None
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        msg = json.loads(raw)
        method = msg.get("method")
        rid = msg.get("id")
        params = msg.get("params") or {}
        if method == "initialize":
            _emit({"jsonrpc": "2.0", "id": rid, "result": {"userAgent": "stub"}})
        elif method == "initialized":
            pass
        elif method == "thread/start":
            thread_id = "thr-stub-1"
            _emit({"jsonrpc": "2.0", "id": rid, "result": {"thread": {"id": thread_id}}})
        elif method == "thread/resume":
            thread_id = params.get("threadId")
            _emit({"jsonrpc": "2.0", "id": rid, "result": {"thread": {"id": thread_id}}})
        elif method == "turn/start":
            TURN_COUNTER[0] += 1
            turn_id = f"turn-{TURN_COUNTER[0]}"
            INTERRUPT.clear()
            _emit({"jsonrpc": "2.0", "id": rid, "result": {"turn": {"id": turn_id}}})
            text = "echo: " + _turn_input_text(params.get("input"))
            threading.Thread(target=run_turn, args=(thread_id, turn_id, text),
                             daemon=True).start()
        elif method == "turn/interrupt":
            INTERRUPT.set()
            _emit({"jsonrpc": "2.0", "id": rid, "result": {}})
        elif rid is not None and ("result" in msg or "error" in msg):
            pass  # client → server の応答(断りなど)
    # EOF: 実物と同じく自分で降りる
    threading.Event().wait(0.05)
    return 0


if __name__ == "__main__":
    sys.exit(main())
