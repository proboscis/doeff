#!/usr/bin/env python3
"""claude の headless(print mode・stream-json の入出力)の替え玉 — 検の PATH に置く。

実物と同じ形の行だけを出す(実測 2026-09-13 / 2026-09-14・conformance/interrupt-physics.md): stdin は
``--input-format stream-json`` の user の行 ``{"type":"user","message":{"role":"user","content":…}}``
を 1 行ずつ読み、1 行 = 1 手番: system/init(session_id)・stream_event の text_delta・
assistant(usage つき)・result。result の後も process は生きて次の行を待ち(温かい)、stdin の
EOF で降りる。DOEFF_HEADLESS_STUB_DELAY 秒だけ result の前で待つ(その間の SIGINT で result を
出さずに降りる = 実物と同じ)。**待っている間に届いた user の行は走っている手番への割り込み**
(実物: CLI が次の tool の境界で注入する)— その本文に反応した assistant の行を出してから
result(num_turns が増える)。DOEFF_HEADLESS_STUB_TURNS_BEFORE_EXIT = N なら N 手番目の result の後に
自分で降りる(SIGINT で止めた・idle で退いた器の再現 — 次の手番は --resume で起こし直される)。
DOEFF_HEADLESS_STUB_LIMIT_TEXT = <文> なら result を provider の限度の断り(is_error・その文)で出す
(段 11 lane 11n 便 C・実弾 2026-09-15 の "You've reached your Fable limit." の再現)。
DOEFF_HEADLESS_STUB_API_ERROR_STATUS = <整数> を併せて置くと、その断りを実物 2.1.27x の形
(subtype success・is_error・terminal_reason api_error・api_error_status = その整数 — 実測 2026-09-17 の
headless-events)で出す(agora-redesign #513: CLI が構造で名乗る status の再現)。API は撃たない。

段 12 lane 12e(agora-redesign #517・card ki-ec55c1318483 — 実弾 2026-09-17 19:4x): 実物の CLI は result の
後も stdin が開いている限り生きて、自分の background task / Monitor の完了(``<task-notification>``)で model を
**手番の外で**起こし直し tool を撃つ。DOEFF_HEADLESS_STUB_REENTER_AFTER = T > 0 はその再現: result の後 T 秒の
内に stdin の EOF が来なければ、手番の外の assistant(tool_use)と 2 つ目の result を出す(host はこれを
読まない — 器が result の行で EOF を出して降ろす、が直し)。EOF が来れば降りる(実物と同じ)。
DOEFF_HEADLESS_STUB_IGNORE_EOF = 1 は EOF で降りない CLI の再現(器の梯子 = SIGTERM で降ろす検の材料)。

依頼 lt-R79KYTYMJH4ZT9X4KHWKCD23KB(実測 2026-09-19 07:28 JST・pod j4bz4 の events・CLI 2.1.263): 前の process が
background task を残したまま降りると、``--resume`` で起きた CLI は本文を読む前に、孤児の task の報せ
(task_notification の "Orphaned by a previous Claude Code process exit …")を**自分の手番**として 1 つ走らせる —
system/init → result(subtype success・num_turns 0・usage 0・``origin: {"kind": "task-notification"}``・result "")。
その後に本文の手番(2 つ目の init …)が続く。DOEFF_HEADLESS_STUB_ORPHAN_NOTICES = N > 0 はその再現: ``--resume`` で
起きた時だけ、stdin を読む前に N 本の報せと CLI 自身の手番を出す。

段 10 lane 10n(実測 2026-09-14): user の行に ``uuid`` が在れば ``command_lifecycle`` でその運命を名乗る
(queued → started → completed / cancelled)。DOEFF_HEADLESS_STUB_TOOL_SECONDS = T > 0 は「T 秒の道具の途中」
= その間は境界が来ないので注入の行は queued のまま(started を出さない)。その間の
``{"type":"control_request","request":{"subtype":"interrupt"}}`` は道具を止める: control_response(success・
still_queued = queued のままの注入の uuid)→ user の "[Request interrupted by user for tool use]" → result
error_during_execution(is_error)→ 元の手番の uuid は cancelled → 注入の行を次の手番として走らせる
(started → init → 反応 → result → completed)。道具が無ければ(T = 0)DELAY の後の境界で畳む(started →
反応 → completed → result・result は 1 つ)。
"""
import hashlib
import json
import os
import select
import sys

USAGE = {"input_tokens": 3, "output_tokens": 7, "cache_creation_input_tokens": 1,
         "cache_read_input_tokens": 2}


def _opt(args, name):
    return args[args.index(name) + 1] if name in args else None


def _auth_digest():
    """自分が受け取った資格の札の**指紋**(段 10 lane 10d 便 2 の追補 2 の検が読む点)。
    値そのものは決して出さない — 検は「誕生の札か、この手番の札か」を指紋で見分ける。"""
    token = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN", "")
    return hashlib.sha256(token.encode("utf-8")).hexdigest()[:12] if token else ""


def _system_env_names():
    """自分の env に居る**系の env の名**(値は出さない — 段 10 lane 10d 便 2 の追補 3 の検が読む点)。
    起こした process が agentd の身元と宛先を継いでいないことを、名の在否だけで確かめる。"""
    return sorted(name for name in os.environ
                  if name.startswith(("ACP_", "DOEFF_", "AGORA_", "RECORD_SERVICE_")))


def _echoed_env():
    """DOEFF_HEADLESS_STUB_ECHO_ENV(, 区切りの名)が名指した env の**値**(無ければ None)— 起こした process に届いた
    宛先を byte で比べる点(card acp:kanban-issue:ki-e930b8506201 の検)。宛先の名だけを名指す(資格の名は名指さない)。"""
    names = [name for name in os.environ.get("DOEFF_HEADLESS_STUB_ECHO_ENV", "").split(",") if name]
    return {name: os.environ.get(name) for name in names}


def _emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def _lifecycle(sid, uuid, state):
    if uuid and not os.environ.get("DOEFF_HEADLESS_STUB_NO_LIFECYCLE"):
        _emit({"type": "command_lifecycle", "command_uuid": uuid, "state": state, "session_id": sid})


def _read_record(timeout):
    """stdin の次の行の record(timeout 秒の内に無ければ None・EOF は "")。"""
    while True:
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if not ready:
            return None
        line = sys.stdin.readline()
        if line == "":
            return ""
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            return record


def _user_text(record):
    content = record.get("message", {}).get("content")
    if isinstance(content, list):
        content = "".join(part.get("text", "") for part in content if isinstance(part, dict))
    return str(content or "")


def _user_images(record):
    """段 10 lane 10o(実測 2026-09-14・conformance/attachment-physics.md): 添付の block の綴りを凍結する。

    受けるのは Messages API と同じ形ちょうど —
    ``{"type":"image","source":{"type":"base64","media_type":<mime>,"data":<base64>}}``。
    content が素の文字列なら添付なし。綴りの違う block(url の形・media-type の綴り違い・source が
    object でない)は **RuntimeError** で落とす: 実物は黙って劣化する(結果が success のまま画像を読まない)ので、
    替え玉は誤綴りを検で赤にする役を持つ。戻り = [(media_type, data), …]。
    """
    content = record.get("message", {}).get("content")
    if not isinstance(content, list):
        return []
    images = []
    for part in content:
        if not isinstance(part, dict) or part.get("type") != "image":
            continue
        source = part.get("source")
        if not isinstance(source, dict):
            raise RuntimeError(f"image block without an object `source`: {part!r}")
        if source.get("type") != "base64":
            raise RuntimeError(f"image source type must be 'base64': {source!r}")
        media_type = source.get("media_type")
        data = source.get("data")
        if not (isinstance(media_type, str) and media_type and isinstance(data, str) and data):
            raise RuntimeError(f"image source needs `media_type` and `data`: {source!r}")
        images.append((media_type, data))
    return images


def _text_blocks(sid, text):
    for piece in (text[:5], text[5:]):
        _emit({"type": "stream_event",
               "event": {"type": "content_block_delta", "index": 0,
                         "delta": {"type": "text_delta", "text": piece}},
               "session_id": sid})


def _assistant(sid, message_id, text):
    _text_blocks(sid, text)
    _emit({"type": "assistant", "session_id": sid,
           "message": {"id": message_id, "role": "assistant", "model": "stub-model",
                       "content": [{"type": "text", "text": text}], "usage": USAGE}})


def _result(sid, text, turns):
    # 段 11 lane 11n 便 C: DOEFF_HEADLESS_STUB_LIMIT_TEXT が在れば provider の限度の断りで終わる
    # (実物の文言 — 族の表を通す材料。実弾 2026-09-15: "You've reached your Fable limit.")。
    limit = os.environ.get("DOEFF_HEADLESS_STUB_LIMIT_TEXT")
    if limit:
        # agora-redesign #513: status が在れば実物の API の誤りの形(CLI が構造で名乗る)
        status = os.environ.get("DOEFF_HEADLESS_STUB_API_ERROR_STATUS")
        if status:
            _emit({"type": "result", "subtype": "success", "is_error": True,
                   "terminal_reason": "api_error", "api_error_status": int(status),
                   "result": limit, "session_id": sid, "usage": USAGE, "num_turns": turns})
            return
        _emit({"type": "result", "subtype": "error_during_execution", "is_error": True,
               "result": limit, "session_id": sid, "usage": USAGE, "num_turns": turns})
        return
    _emit({"type": "result", "subtype": "success", "is_error": False, "result": text,
           "session_id": sid, "usage": USAGE, "num_turns": turns})


def _turn(sid, prompt, uuid, resumed, carried=False):
    """1 手番。戻り = 次の手番として走らせる (本文, uuid)(停止の合図で注入の行が生き残った時)か None。
    carried = 停止の合図で生き残った注入の行の手番(実物: 短い返答 — 道具も待ちも無い)。"""
    _lifecycle(sid, uuid, "started")
    _emit({"type": "system", "subtype": "init", "session_id": sid, "model": "stub-model",
           "cwd": os.getcwd(), "resumed": resumed, "auth_digest": _auth_digest(),
           "system_env_names": _system_env_names(), "echoed_env": _echoed_env(),
           # 実物 2.1.270 の名乗り(段 10 lane 10n)— DOEFF_HEADLESS_STUB_NO_LIFECYCLE=1 で旧い CLI(名乗らない)を真似る
           "capabilities": [] if os.environ.get("DOEFF_HEADLESS_STUB_NO_LIFECYCLE") else
           ["interrupt_receipt_v1", "interrupt_cancel_queued_v1", "msg_lifecycle_v1"]})
    text = "echo: " + prompt.strip().splitlines()[0] if prompt.strip() else "echo:"
    delay = 0.0 if carried else float(os.environ.get("DOEFF_HEADLESS_STUB_DELAY", "0") or "0")
    tool = 0.0 if carried else float(os.environ.get("DOEFF_HEADLESS_STUB_TOOL_SECONDS", "0") or "0")
    turns = 1
    _assistant(sid, "msg_stub", text)
    queued = []  # 境界を待つ注入の (本文, uuid)
    if delay:
        # 道具の途中(tool 秒)は境界が来ない: 注入は queued のまま、停止の合図で止まる。
        deadline_tool = tool
        while True:
            wait = deadline_tool if deadline_tool > 0 else delay
            record = _read_record(wait)
            if record is None or record == "":
                break
            if record.get("type") == "user":
                injected_text = _user_text(record)
                injected_seen = _user_images(record)
                if injected_seen:
                    injected_text = injected_text + "".join(
                        f" [saw {mime} {len(data)}b]" for mime, data in injected_seen)
                queued.append((injected_text, record.get("uuid")))
                _lifecycle(sid, record[
                    "uuid"] if record.get("uuid") else None, "queued")
                if deadline_tool > 0:
                    continue
                break
            if record.get("type") == "control_request" and \
                    record.get("request", {}).get("subtype") == "interrupt":
                still = [u for _, u in queued if u]
                _emit({"type": "control_response",
                       "response": {"subtype": "success", "request_id": record.get("request_id"),
                                    "response": {"still_queued": still}}})
                _emit({"type": "user", "session_id": sid,
                       "message": {"role": "user", "content": [
                           {"type": "text", "text": "[Request interrupted by user for tool use]"}]}})
                _emit({"type": "result", "subtype": "error_during_execution", "is_error": True,
                       "result": "", "session_id": sid, "usage": USAGE, "num_turns": turns,
                       "errors": ["[ede_diagnostic] stop_reason=tool_use"]})
                _lifecycle(sid, uuid, "cancelled")
                return queued[0] if queued else None
        # 境界: 畳む(実物: 次の tool の境界で注入を model に見せる)
        for injected, injected_uuid in queued:
            turns += 1
            _lifecycle(sid, injected_uuid, "started")
            reaction = "interrupted: " + injected.strip().splitlines()[0]
            _assistant(sid, "msg_stub_2", reaction)
            _lifecycle(sid, injected_uuid, "completed")
            text = reaction
    _result(sid, text, turns)
    _lifecycle(sid, uuid, "completed")
    return None


def main():
    args = sys.argv[1:]
    argv_log = os.environ.get("DOEFF_HEADLESS_STUB_ARGV_LOG")
    if argv_log:
        # 検の読み手: 起こされた順に argv を 1 行ずつ(冷えた再開の前の圧縮が手番の前に走ったか)
        with open(argv_log, "a", encoding="utf-8") as handle:
            handle.write(" ".join(args) + "\n")
    if "--help" in args:
        sys.stdout.write("stub claude\n")
        return 0
    sid = _opt(args, "--session-id") or _opt(args, "--resume") or "stub-session"
    resumed = "--resume" in args
    if "--input-format" not in args:
        # 旧の作法(本文 + EOF)— 段 8 lane 4x より前の呼び手の互換
        _turn(sid, sys.stdin.read(), None, resumed)
        return 0
    orphans = int(os.environ.get("DOEFF_HEADLESS_STUB_ORPHAN_NOTICES", "0") or "0")
    if resumed and orphans > 0:
        _cli_own_turn(sid, orphans)
    exit_after = int(os.environ.get("DOEFF_HEADLESS_STUB_TURNS_BEFORE_EXIT", "0") or "0")
    reenter = float(os.environ.get("DOEFF_HEADLESS_STUB_REENTER_AFTER", "0") or "0")
    turns = 0
    carried = None
    pending = None  # 再入の待ちの間に届いた次の手番の user の行
    while True:
        was_carried = carried is not None
        if carried is not None:
            prompt, uuid = carried
            carried = None
        else:
            record = pending if pending is not None else _read_record(None)
            pending = None
            if record == "" or record is None:
                if os.environ.get("DOEFF_HEADLESS_STUB_IGNORE_EOF"):
                    _ignore_eof()
                return 0
            if record.get("type") != "user":
                continue
            prompt, uuid = _user_text(record), record.get("uuid")
            # 段 10 lane 10o: 見た添付を答えに混ぜる(検が「model が画像を受け取った」ことを読める形)。
            seen = _user_images(record)
            if seen:
                prompt = prompt + "".join(f" [saw {mime} {len(data)}b]" for mime, data in seen)
            _lifecycle(sid, uuid, "queued")
        carried = _turn(sid, prompt, uuid, resumed, was_carried)
        resumed = True
        turns += 1
        if exit_after and turns >= exit_after:
            return 0
        if reenter > 0 and carried is None:
            # 実物の隙間: result の後・EOF の前に background task の完了が来ると model が手番の外で起きる。
            record = _read_record(reenter)
            if record == "":
                if os.environ.get("DOEFF_HEADLESS_STUB_IGNORE_EOF"):
                    _ignore_eof()
                return 0
            if record is None:
                _reenter(sid, turns)
            else:
                pending = record


def _cli_own_turn(sid, orphans):
    """CLI 自身の手番(実物 2.1.263 の綴り): 孤児の task の報せ N 本 → init → model を呼ばない result(origin
    task-notification)。本文の手番ではない — 器がこの result で手番を閉じると、続く本文の手番が切られる。"""
    for index in range(orphans):
        _emit({"type": "system", "subtype": "task_notification", "task_id": f"bstub{index}",
               "tool_use_id": f"toolu_stub_orphan_{index}", "status": "stopped", "output_file": "",
               "summary": "Orphaned by a previous Claude Code process exit and reported in an aggregate summary.",
               "session_id": sid})
    _emit({"type": "system", "subtype": "init", "session_id": sid, "model": "stub-model",
           "cwd": os.getcwd(), "resumed": True, "auth_digest": _auth_digest(),
           "system_env_names": _system_env_names(), "echoed_env": _echoed_env(),
           "capabilities": [] if os.environ.get("DOEFF_HEADLESS_STUB_NO_LIFECYCLE") else
           ["interrupt_receipt_v1", "interrupt_cancel_queued_v1", "msg_lifecycle_v1"]})
    zero = {"input_tokens": 0, "output_tokens": 0, "cache_creation_input_tokens": 0,
            "cache_read_input_tokens": 0}
    _emit({"type": "result", "subtype": "success", "is_error": False, "result": "", "session_id": sid,
           "usage": zero, "modelUsage": {}, "num_turns": 0, "duration_api_ms": 0,
           "origin": {"kind": "task-notification"}, "queued_turn_count": 0})


def _reenter(sid, turns):
    """手番の外の行動(実物: <task-notification> で起きた model の tool_use と 2 つ目の result)。"""
    _emit({"type": "assistant", "session_id": sid,
           "message": {"id": "msg_stub_reenter", "role": "assistant", "model": "stub-model",
                       "content": [{"type": "text", "text": "<task-notification> background task finished"},
                                   {"type": "tool_use", "id": "toolu_stub_reenter", "name": "Bash",
                                    "input": {"command": "echo outside-the-turn"}}],
                       "usage": USAGE}})
    _emit({"type": "result", "subtype": "success", "is_error": False, "result": "outside-the-turn",
           "session_id": sid, "usage": USAGE, "num_turns": turns + 1, "reentered": True})


def _ignore_eof():
    """EOF で降りない CLI の再現: 信号で降ろされるまで居座る(SIGTERM の既定の作法で降りる)。"""
    import time
    while True:
        time.sleep(0.2)


if __name__ == "__main__":
    sys.exit(main())
