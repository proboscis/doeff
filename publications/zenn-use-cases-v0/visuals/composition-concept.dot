digraph figure {
graph [bgcolor="#122336", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="LR", fontname="Hiragino Sans", fontsize=25, fontcolor="#f4f8fc", labelloc="t", label="違う関心事を、同じyieldでつなぐ\n"];
node [shape=box, style="rounded,filled", fillcolor="#203951", color="#55748e", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#f4f8fc", margin="0.22,0.17"];
