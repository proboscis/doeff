digraph figure {
graph [bgcolor="#f8fafc", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="TB", fontname="Hiragino Sans", fontsize=25, fontcolor="#152c43", labelloc="t", label="同じ操作を、本番かテスト環境で扱う\n"];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3d2e0", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#152c43", margin="0.22,0.17"];
edge [color="#087e8b", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#087e8b"];
p [label="外部操作のエフェクトを依頼"];
h [label="実行時にハンドラを選ぶ", shape=diamond, margin="0.1", fillcolor="#e7f5f2"];
a [label="本番: 対応するサービスを操作"];
t [label="テスト: メモリ上で記録・応答"];
r [label="結果を処理本体へ返す"];
p -> h [label=""];
h -> a [label="本番"];
h -> t [label="テスト"];
a -> r [label=""];
t -> r [label=""];
}
