digraph figure {
graph [bgcolor="#122336", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="TB", fontname="Hiragino Sans", fontsize=25, fontcolor="#f4f8fc", labelloc="t", label="同じHTTP処理に、記録と再生を選ぶ\n"];
node [shape=box, style="rounded,filled", fillcolor="#203951", color="#55748e", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#f4f8fc", margin="0.22,0.17"];
edge [color="#79e4c4", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#79e4c4"];
p [label="処理本体\nHttpRequest"];
r [label="記録ハンドラ"];
a [label="外部HTTP"];
s [label="保存した依頼と応答"];
v [label="再生ハンドラ"];
