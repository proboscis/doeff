edge [color="#087e8b", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#087e8b"];
a [label="2つのAgentSpec\n仕事・作業場所・結果スキーマ"];
b [label="文章レビュー\nSpawn → LaunchSession"];
