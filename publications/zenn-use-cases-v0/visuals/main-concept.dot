digraph figure {
graph [bgcolor="#122336", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="LR", fontname="Hiragino Sans", fontsize=25, fontcolor="#f4f8fc", labelloc="t", label="操作は同じ、解釈はハンドラ次第\n"];
node [shape=box, style="rounded,filled", fillcolor="#203951", color="#55748e", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#f4f8fc", margin="0.22,0.17"];
edge [color="#79e4c4", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#79e4c4"];
p [label="処理の手順\n@do / yield"];
e [label="エフェクト\n操作の依頼"];
s [label="標準のハンドラ\nすぐに使う"];
c [label="自作のハンドラ\n別の基盤へ接続"];
t [label="テストのハンドラ\n入力と結果を制御"];
p -> e [label="依頼"];
e -> s [label="選んで解釈"];
e -> c [label="選んで解釈"];
e -> t [label="選んで解釈"];
}
