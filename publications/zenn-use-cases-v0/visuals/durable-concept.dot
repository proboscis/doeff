digraph figure {
graph [bgcolor="#122336", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="TB", fontname="Hiragino Sans", fontsize=25, fontcolor="#f4f8fc", labelloc="t", label="完了した仕事の結果を、再実行へ渡す\n"];
node [shape=box, style="rounded,filled", fillcolor="#203951", color="#55748e", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#f4f8fc", margin="0.22,0.17"];
edge [color="#79e4c4", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#79e4c4"];
p [label="計算を再実行"];
h [label="メモ化のハンドラ"];
s [label="永続ストレージ\n保存した結果"];
c [label="未完了の計算"];
n [label="後続の処理"];
