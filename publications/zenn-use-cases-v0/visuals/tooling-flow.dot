digraph figure {
graph [bgcolor="#f8fafc", pad="0.45", nodesep="0.4", ranksep="0.58", rankdir="TB", fontname="Hiragino Sans", fontsize=25, fontcolor="#152c43", labelloc="t", label="設計とコードを、発見・検査できる形にする\n"];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c3d2e0", penwidth=1.4, fontname="Hiragino Sans", fontsize=19, fontcolor="#152c43", margin="0.22,0.17"];
edge [color="#087e8b", arrowsize=0.8, penwidth=1.7, fontname="Hiragino Sans", fontsize=14, fontcolor="#087e8b"];
d [label="計算・エフェクト・ハンドラを定義"];
i [label="索引や静的解析で関係を調べる"];
r [label="規則・領域・設計判断を記述"];
t [label="採用した検査をpytestやlintへ接続"];
q [label="検査が通る？", shape=diamond, margin="0.1", fillcolor="#e7f5f2"];
f [label="定義や実装を修正"];
n [label="検査済みの変更をレビュー"];
d -> i [label=""];
i -> r [label=""];
r -> t [label=""];
t -> q [label=""];
q -> f [label="いいえ"];
f -> d [label=""];
q -> n [label="はい"];
}
