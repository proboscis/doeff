#!/bin/sh
# doeff's plain commit hook -- applies to the staged snapshot (1) the semgrep rules,
# (2) the baseline comparison of doeff-linter findings, and
# (3) the authoring-time reconciliation of the enforcement ledger (ADR-DOE-ENFORCE-001 R7).
# Installed by make hooks-install (the tracked original is this file). The agora worker Pod also installs the same copy
# (agora deploy/agent-worker/worker-prepare.sh). On a machine where the pre-commit framework is set up (make pre-commit-install) the
# .pre-commit-config.yaml entries fire the same 3 and this file is not installed.
#
# Why authoring time: the landing window is mechanics only (mode is focus), and
# direct pushes do not even pass through the window -- on any route a commit always passes through the authoring machine's git, so
# this is the first and only point that can structurally stop a bookkeeping omission (2026-08-21 live incident f47f0a4b: a new ADR reached main with the ledger not updated).
# The canonical gate remains the default pytest as in R1
# (this hook is an alias of it -- the daily verify remains).
set -u

# Do not judge during a rebuild (rebase / cherry-pick / revert / sequencer) --
# following and replay in the landing window are operations that "carry already-existing content again", and the author is not this
# process (the same guard as the prepare-commit-msg hook).
GITDIR="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$GITDIR" ]; then
  for _st in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer; do
    if [ -e "$GITDIR/$_st" ]; then
      exit 0
    fi
  done
fi

TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$TOP" ] || exit 0

# (1) Apply the semgrep rules (.semgrep.yaml) to the staged files. Which entry applies to which file is in one place, the
# semgrep entry of .pre-commit-config.yaml (alias semgrep-rules) -- here we only fire that alias with the pre-commit of the uv.lock version (the working tree's .venv is not needed).
# Without it, a commit on a machine with only the plain hook would not pass the semgrep rules, and the findings would first
# go red in the next day's daily (test_semgrep_findings_match_baseline_ratchet) (the 5th round of 2026-10-11 -- a Pod commit added a user-side system name to a generic package). Old snapshots (trees without the entry) are not blocked.
RULES="$TOP/scripts/precommit_locked.py"
if [ -f "$RULES" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run semgrep-rules) || {
    echo "doeff commit hook: the semgrep rules entry is red (findings in the staged files, or it could not run -- see the output above)." \
      "Fix the findings and stage again." >&2
    exit 1
  }
fi

# (2) Compare the doeff-linter findings with the baseline per rule x file (scripts/hook_finding_baseline/doeff-linter.json). The comparing entry is
# the single id doeff-linter in .pre-commit-config.yaml, and here we only fire that id with the same pre-commit (the same form as the semgrep entry).
# Without it, a commit on a machine with only the plain hook (the agora worker Pod) would not pass the linter baseline, and findings over the baseline would also slip through the landing window (which looks only at conflict marks
# -- rule land-gate-runs-no-tests) into main, and would first go red in the lint stage of the daily full verification
# (the round of 2026-10-19 04:05 JST -- 3 commits on 10-18 added 9 DOEFF004 findings to 2 test files). When the linter of the baseline's key is not in the machine's store,
# the entry names it "unmeasurable" and passes (the linter is not built inside a commit -- the daily stage measures the passed commit with --strict).
# Old snapshots (trees without the entry) are not blocked.
if [ -f "$RULES" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run doeff-linter) || {
    echo "doeff commit hook: the doeff-linter entry is red (findings that grew over the baseline, or it could not run -- see the output above)." \
      "Fix the findings in code and stage again (do not add them to the baseline)." >&2
    exit 1
  }
fi

# (2b) A commit that touches the linter's build inputs or the baseline file keeps the baseline version equal to the key of the staged linter
# inputs (the single id doeff-linter-baseline-key of .pre-commit-config.yaml -- no binary, no build). Old snapshots without the entry are not blocked.
if [ -f "$RULES" ] && grep -q 'id: doeff-linter-baseline-key' "$TOP/.pre-commit-config.yaml" 2>/dev/null; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run doeff-linter-baseline-key) || {
    echo "doeff commit hook: the doeff-linter baseline does not name the key of the staged linter inputs (see the output above)." \
      "Recount it with the linter built from this tree and stage it in the same commit." >&2
    exit 1
  }
fi

# (3a) Forgetting to rebuild the .pyi next to a .hy. The entry is the single alias hy-stubs of .pre-commit-config.yaml.
# It calls doeff_hy in the tree's environment (uv run), so old snapshots without the entry are not blocked.
if [ -f "$TOP/scripts/check_hy_stubs.py" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run hy-stubs) || {
    echo "doeff commit hook: the .pyi next to a .hy is stale (see the output above). Rebuild it and stage again." >&2
    exit 1
  }
fi

# (3b) A quotation that copies the owner's chat words with a date. The entry is the single id no-chat-quotes of .pre-commit-config.yaml,
# and it looks only at the staged files. Old snapshots without the entry are not blocked.
if [ -f "$TOP/scripts/check_no_operator_quotes.py" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run no-chat-quotes) || {
    echo "doeff commit hook: there is a dated quotation of the owner's chat words (see the output above). Write the decision and reason in the record's own words," \
      "turn the provenance into a short mark, and stage again." >&2
    exit 1
  }
fi

# (3) Authoring-time reconciliation of the enforcement ledger.
CHECK="$TOP/scripts/check_enforcement_ledger.py"
# Old snapshots lack the mechanism -- not blocked.
[ -f "$CHECK" ] || exit 0

# A commit that does not touch enforcement assets passes through (the check is imposed on the commit that touched them).
if git diff --cached --quiet -- docs/adr .semgrep.yaml; then
  exit 0
fi

# Reconcile the staged snapshot (index) -- reconciling the working tree would let "the ledger was also fixed but
# forgot to stage" pass. A mismatch stops the commit (if deliberately bypassed with --no-verify,
# the daily verify still catches it). The ledger is a generated artifact, fixed by
# `make enforcement-ledger`. A drift already in HEAD is only reported, and if this commit's own
# additions and removals are reflected in the ledger it passes (ADR-DOE-ENFORCE-001 R9 -- do not block on an unrelated drift
# and make bypassing the norm).
# Do not fire the machine's python -- uv reads the script's PEP 723 declaration (no dependencies).
exec uv run --script "$CHECK" --staged
