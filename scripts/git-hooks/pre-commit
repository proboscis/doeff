#!/bin/sh
# doeff の素の commit の hook — stage した断面に (1) semgrep の規則(card ki-8c0bb496bfab)と
# (2) doeff-linter の所見の基点の比べ(card ki-c6f026ac047e)と
# (3) enforcement 台帳の著述時突合(ADR-DOE-ENFORCE-001 R7)を当てる。
# 導入 = make hooks-install(tracked 原本はこのファイル)。agora の担当の Pod も同じ写しを入れる
# (agora deploy/agent-worker/worker-prepare.sh)。pre-commit の枠組みを据え付けた機体(make pre-commit-install)は
# .pre-commit-config.yaml の項が同じ 3 つを撃ち、この file は入らない。
#
# なぜ著述時か: 着地の窓は力学のみ(2026-08-17 operator 裁定・mode = "focus")で、
# 直接 push は窓さえ通らない — どの経路でも commit は必ず著述機の git を通るので、
# 記帳漏れ(2026-08-21 実弾 f47f0a4b: ADR 新設が台帳未更新で main へ)を構造的に
# 止められる最初で唯一の点はここ。正典ゲートは R1 のとおり既定 pytest のまま
# (この hook はその別名 — 日次 verify は残る)。
set -u

# 作り直し(rebase / cherry-pick / revert / sequencer)中は判定しない —
# 着地の窓の追随・replay は「既に在る中身を運び直す」操作で、著者はこの
# process ではない(prepare-commit-msg hook と同じ guard)。
GITDIR="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$GITDIR" ]; then
  for _st in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer; do
    if [ -e "$GITDIR/$_st" ]; then
      exit 0
    fi
  done
fi

TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$TOP" ] || exit 0

# (1) semgrep の規則(.semgrep.yaml)を stage した file に当てる。どの file にどの項を当てるかは .pre-commit-config.yaml の
# semgrep の項(別名 semgrep-rules)の 1 か所 — ここは uv.lock の版の pre-commit でその別名を撃つだけ(作業木の .venv は要らない)。
# 無いと素の hook だけの機体の commit は semgrep の規則を通らず、所見は翌日の日次(test_semgrep_findings_match_baseline_ratchet)で
# 初めて赤になる(2026-10-11 の 5 回 — Pod の commit が汎用の package に使い手の系の名を足した)。古い断面(入口の無い木)は塞がない。
RULES="$TOP/scripts/precommit_locked.py"
if [ -f "$RULES" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run semgrep-rules) || {
    echo "doeff の commit の hook: semgrep の規則の項が赤(stage した file の所見か、走らせられなかった — 上の出力)。" \
      "所見を直して stage し直す。" >&2
    exit 1
  }
fi

# (2) doeff-linter の所見を、規則 × file の基点(scripts/hook_finding_baseline/doeff-linter.json)と比べる。比べる項は
# .pre-commit-config.yaml の id doeff-linter の 1 つで、ここは同じ pre-commit でその id を撃つだけ(semgrep の項と同じ形)。
# 無いと素の hook だけの機体(agora の担当の Pod)の commit は linter の基点を通らず、基点を越える所見が着地の窓(衝突の印
# だけを見る — operator 裁定 land-gate-runs-no-tests)も素通りして main に入り、日次の全体検証の lint の段で初めて赤になる
# (2026-10-19 04:05 JST の回 — 10-18 の 3 commit が検の file 2 つに DOEFF004 を 9 件足した)。基点の鍵の linter が機体の置き場に
# 無い時は、項が「測れない」と名指して通す(commit の中で linter を組まない — 通った commit は日次の段が --strict で測る)。
# 古い断面(入口の無い木)は塞がない。
if [ -f "$RULES" ]; then
  (cd "$TOP" && uv run --no-project --python 3.12 python "$RULES" run doeff-linter) || {
    echo "doeff の commit の hook: doeff-linter の項が赤(基点より増えた所見か、走らせられなかった — 上の出力)。" \
      "所見を code で直して stage し直す(基点に足さない)。" >&2
    exit 1
  }
fi

# (3) enforcement 台帳の著述時突合。
CHECK="$TOP/scripts/check_enforcement_ledger.py"
# 古い断面には機構が無い — 塞がない。
[ -f "$CHECK" ] || exit 0

# enforcement 資産に触れない commit は素通し(検査は触った commit に課す)。
if git diff --cached --quiet -- docs/adr .semgrep.yaml; then
  exit 0
fi

# staged 断面(index)を突合する — working tree 突合は「台帳も直したが
# stage し忘れた」を素通しするため。不一致は commit を止める(--no-verify で
# 意識的に踏み越えた場合も日次 verify が捕まえる)。台帳は生成物で、直しは
# `make enforcement-ledger`。HEAD に既に在るずれは申告だけで、この commit 自身の
# 増減が台帳に写っていれば通す(ADR-DOE-ENFORCE-001 R9 — 無関係なずれで塞いで
# 迂回を常態にしない)。
# 機体の python は撃たない — script の PEP 723 の宣言を uv が読む(依存なし)。
exec uv run --script "$CHECK" --staged
