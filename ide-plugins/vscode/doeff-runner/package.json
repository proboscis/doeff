    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:unit": "npm run compile && node scripts/run-unit-tests.js",
    "pixel": "npm run compile && node scripts/build-pixel.js",
    "pixel:check": "npm run compile && node scripts/build-pixel.js --check",
    "pixel:preview": "npm run compile && node scripts/build-pixel.js --preview out/pixel/preview.html"
  },
