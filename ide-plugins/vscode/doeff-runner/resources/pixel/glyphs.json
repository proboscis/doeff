  "families": [
    {
      "name": "declaration",
      "label": "宣言",
      "summary": "名前を付けて宣言する物(def* の頭)— 宇宙港で働く物の sprite(端末・貨物の木箱・データのカートリッジ・ゲート・星図)。",
      "frame": null
    },
    {
      "name": "flow",
      "label": "値と流れ",
      "summary": "Program の値と受け渡し・戻り・終わり — 水色の矢印・吹き出し・再開のボタン・ゴールの旗。",
      "frame": null
    },
    {
      "name": "failure",
      "label": "失敗の語彙",
      "summary": "失敗を表す語 — 赤と桃色の差し色の sprite(空の貨物室・信号弾・外れた接続・止める手・ぶつかる矢印・壊れたカートリッジ)。",
      "frame": null
    },
    {
      "name": "layer",
      "label": "層",
      "summary": "層ごとの建物 — core = ドームの家・intent = 立て札・protocol = 通訳のロボット・foundation = 係留の錨・entry = エアロックの扉。",
      "frame": null
    },
    {
      "name": "lint",
      "label": "linter の印",
      "summary": "定義に付く状態 — 警報灯(赤)・琥珀の灯・青い灯・工事中の三角コーン・霧・ふくろうのロボット。",
      "frame": null
    },
    {
      "name": "rule",
      "label": "linter の規則",
      "summary": "違反の欄の行の sprite — 規則の家族ごとの物。付いた灯(L)が違反の重さの色に灯る(赤 = error・琥珀 = warning・青 = info・暗い灰 = 消えている)。",
      "frame": null
    },
