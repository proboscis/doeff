;;; Executable ADR: doeff の subpackage(packages/ の下の package)が利用者に見せる公開 API は、effect と handler と handler を返す工場と、
;;; それらを作り・答えを読み・失敗を受け・handler を組むのに要る型と、名ごとに許した program の helper(effect を出すだけの program を
;;; 返す関数 — R18)だけ。ほかの名は、名か module の path に _ を付けた内側に置くか、effect か handler か工場に作り直す。handler は
;;; 印 _doeff_is_handler_fn の付いた callable の値(中核の ProgramHandler)で、program に当てる公式の形は h1(h2(p))。
;;;
;;; 出自 = 持ち主の決定 2026-10-26(取り組み doeff-subpackages-effects-only・発言 ci-VJFV7TDC7NRK59STYR26GGHZV8・card ki-bd3bec7b1360)。
;;; 範囲と境界の扱いは、依頼書 lt-6KJ8EG0YPWXCQ2GRC5XNSQVNQM(6 問)と、名ごとに問い直した続きの書の答え(どれも 2026-10-27)に従う
;;; (:decision の各条に答えの id を書く)。handler の形と当て方・工場は持ち主の決定 2026-10-28(発言 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜
;;; ci-AFX0HEJAT7SAMANA3YCPKE9RJA・card ki-25eecd63bc57)に従い、R3・R6 をそれで改めた。scheduled を工場にしない事は持ち主の方針 2026-10-30
;;; (発言 ci-1C69G7ED3693KC72N4XET8SZPQ・ci-HR642QPZJRX04MS5PFYCGPY0E4・card ki-8187e8827ad9)に従い R6 を改めた。program の helper は持ち主の答え 2026-10-29
;;; (lt-R3TYRMMEM7YN0G9J9D2RZMVX3X・card ki-f20b18c2aad9)に従い R18 に足した。doeff-validation の check と perform を型にする事は持ち主の
;;; 答え 2026-10-29(lt-MHFWEYBQYCC2PQYR84VKXBAET8・card ki-2750cc5e5209)に従い R19 に足した。doeff-adr の get_adr は R20、adr_ids は R21、Semgrep の検の
;;; 2 つの関数は R22(答え lt-KY48MR4KP2N0GS9MQCCJTJMH55・lt-19276K37Z3TCCRTBMXWBMMXVMN・card ki-2a549274055c)。まだ問うていない道具の package 7 個のうち、答えの出た条で決まる
;;; doeff-vm-core と doeff-linter を R23 に足した(card ki-4c1d18a98579)。doeff-effect-analyzer の解析の関数を effect と解析の handler にする事は
;;; R24(答え lt-646XDCG0CJXMX7JP6558JD426W・card ki-593f9f44c501)。外れの組の helper の形の program 関数のうち、外が使う 155 名だけを
;;; 許す事は R25(答え lt-7EK027YNFXTP27QE60J7Q686CZ・card ki-9261e8b524d8)。解析の見本 doeff-test-target を packages の下から
;;; doeff-effect-analyzer の test の dir へ移す事は R26(答え lt-H74EV6FXSHXAWRP91037VW86QD・card ki-0e4728cb69c6)。doeff-indexer の索引を引く口は
;;; R27(答え lt-ZDN45RSNPV16BKSM997GGZ9CVB・card ki-1e51e218527e)。workflow の Rust の CLI の package を消して Python の CLI に
;;; 寄せる事は R28(答え lt-T9TTHBXF5YK0B1FBJGFCZF6CZ1・card ki-7b2e293a2db7)。doeff-vm を doeff の中の部品として目録の範囲の外に
;;; 置く事は R10 の答えに合わせて R11 で決めた(card ki-9c326052f21c)。doeff-domain の表を置く・引く・check する関数 8 個は R29(答え
;;; lt-FP17P0A4CPBC1RJCF9BFBVF4WV・card ki-03a7f0af2b64)。doeff-adr の ADR の形を確かめる関数 2 個と deftest の検を載せる関数は R30(答え
;;; lt-RA4FZ731JNZQ6JEGVAYD35XCAZ・card ki-54e559d3c0e7)。doeff-hy の外の macro の置き場と doeff-hy の道具の入口は R31(持ち主の決め・
;;; card ki-d80c9c978b35)。doeff-adr の登録簿を読み書きする関数 4 個は R32(答え lt-RA4FZ731JNZQ6JEGVAYD35XCAZ・card ki-dab8943cf664)。
;;; doeff-adr を範囲「決まりの範囲」に入れ、submodule の移し替えの module を消す事は R33(同じ答え・card ki-ae23c91f6e75)。
;;; 答えの無い物は R13 の「未決」に並べ、答えが来たら
;;; 持ち主がこの ADR に条を足す。
;;;
;;; 強制は card ki-aaaa56621c5a の test(tests/test_public_api_known_violations.py)が持つ。公開 API を数える 1 か所
;;; (tools/public_api_inventory.py)の目録を、package ごとの既知の表(違反の表 tests/data/public_api_known_violations.json — 外れと
;;; 境界だけ・減るだけ)と許した物の表(tests/data/public_api_allowed.json — 決まりが名ごとに許した名・決めの id つきで足せる)と
;;; 突き合わせる。工場と読めた名は目録の道具が呼んで印を確かめ、印の無い値を返す名を外れと数える(R3)。許した物の表の組
;;; 「許した物 — program の helper」の名は、目録の道具が中を読んで helper の形(R18)と確かめた物だけを置ける。組「許した物 — Hy の
;;; macro」と「許した物 — CLI コマンド」の名も、目録の行の形で確かめる(R31)。この ADR は別の検を
;;; 作らない — law の :enforced-by がその test を指し、この file の deftest はその test の関数を呼ぶだけ(R12)。
;;;
;;; 戻し方: 決まりを外すなら、この file と tests/test_public_api_known_violations.py と既知の表と許した物の表を消し、台帳(docs/adr/enforcement-ledger.json)を
;;; 作り直す。範囲か境界の 1 条を改めるなら、その条と既知の表の範囲と組を同じ commit で改める。外すのは持ち主の言葉が在る時だけ。

(require doeff-adr.macros [defadr rule law])
(import doeff-adr.macros [fact interpretation counterexample])
(require doeff-hy.macros [defk deftest val <-])
(import importlib.util)
(import pathlib [Path])
(import sys)
(import tempfile)
(import types [ModuleType])


(val ROOT (get (. (.resolve (Path __file__)) parents) 2))
(val GUARD-TEST "tests/test_public_api_known_violations.py")


(defk guard-module []
  {:pre [] :post [(: % ModuleType)] :tags {:context "doeff-api-adr" :role "foundation"}}
  "card ki-aaaa56621c5a の test の module を読む(tests/ は package でない — pytest が集める物と混ぜないよう別の名で読む)。
   読む前に sys.modules へ載せる — module の中の dataclass は、欄の註を読む時に自分の module を sys.modules から引く。"
  (val spec (importlib.util.spec-from-file-location "_adr_doe_api_001_guard" (/ ROOT GUARD-TEST)))
  (val module (importlib.util.module-from-spec spec))
  (setv (get sys.modules spec.name) module)
  (.exec-module spec.loader module)
  module)


(defadr ADR-DOE-API-001
  :title "doeff の subpackage が利用者に見せる公開 API は effect と handler と handler を返す工場と、それらの値・結果・例外・設定の型と、名ごとに許した program の helper(effect を出すだけの program を返す関数)だけ。handler は印の付いた callable の値(ProgramHandler)で、program には h1(h2(p)) で当て、class で書かず、公開の名は subpackage の入口からだけ出す。強制は公開 API の目録と減るだけの既知の表を突き合わせる 1 つの test が持ち、工場は呼んで handler が返る事を、helper は中を読んで handler を被せず effect に答えない事を見る"
  :status "accepted"
  :scope ["packages/*/ (subpackage の import の根・submodule・[project.scripts]・entry point)"
          "packages/doeff-vm/ (doeff の中の部品 — 目録が数えず、doeff の外が import しない事を表の test が見る・R11)"
          "tools/public_api_inventory.py (公開 API を数える 1 か所)"
          "tests/test_public_api_known_violations.py (強制 — card ki-aaaa56621c5a)"
          "tests/data/public_api_known_violations.json (既知の表 — 違反の表・減るだけ)"
          "tests/data/public_api_allowed.json (許した物の表 — 決めの id つきで足せる)"
          "docs/adr/defadr_doeff_api_001_subpackages_show_effects_and_handlers.hy"]
  :problem
    [(fact
       "持ち主は 2026-10-26 に、doeff の subpackage が利用者に出す物は effect と handler で、ほかは出さないと決めた。"
       :evidence "取り組み doeff-subpackages-effects-only・持ち主の発言 ci-VJFV7TDC7NRK59STYR26GGHZV8")
     (fact
       "発端: 2026-10-26 の docs/19-agent-tutorial.md とその動画は、doeff-agents の class ScenarioAgentHandler を作って .wrap で program を包む形を見せ、doeff_agents の根は launch_session・monitor_session のような、session を手で起こして見張る手続き型の関数を出していた。そこから利用者は、effect を yield して handler を据える doeff の書き方でない使い方を覚える。"
       :evidence "commit 548f04f62(card ki-4b53dcee28f3)が doeff_agents の根から外した 69 名と、その前の版の docs/19-agent-tutorial.md")
     (fact
       "公開 API の目録(card ki-633e6b8564b4)は packages/ の下の 39 package の公開の名に種類(effect・handler・それ以外・未分類)を付け、card ki-1c2bd5bea63f がそれ以外と未分類を、外れ(直しの向きつき)と境界(種類つき)に分けた。決まりの文だけでは入るか外れるかが決まらない境界と、effect と handler を出す物でない道具の package 12 個が残った。"
       :evidence "tools/public_api_inventory.py・tests/data/public_api_known_violations.json の組の名")
     (fact
       "境界と道具の package の扱いを、依頼書 lt-6KJ8EG0YPWXCQ2GRC5XNSQVNQM(道具の package・型・class の形の handler・combinator・submodule・CLI コマンドと __version__ の 6 問)で問い、2026-10-27 に 6 問とも答えが出た。型と submodule はそのまま決まり、class の形の handler は案の外の向き(class で書かない)に決まった。道具の package・combinator・CLI コマンドと __version__ は、名ごとに具体的に見せて問い直す答えで、続きの書が名ごとに決めている。"
       :evidence "依頼書 lt-6KJ8EG0YPWXCQ2GRC5XNSQVNQM の答え lt-8V00BBVKMV2CVHB45S00A3558Z・lt-85SHMNQG7HG4AYHBER6V2BAKX6・lt-RMPE1XQ9RVWV4S8N0GTBE40Y61・lt-K1C6JM29MWVBHH9H7891JP4BG2・lt-YM5YVPMR3BAR0XR6DNEGG6PA9P・lt-8T39MYCBSHJDX310DXMB6205VS")
     (fact
       "既知の違反の表(main edc3802d5b5f): 39 package の 13,753 行と「足した名」31 行。外れの組と減らす向き — 外れ — handler の中へ入れる 2,498(handler だけが使う部品は handler の module の _ の付いた所へ・R1)・外れ — 内側の module へ移す 2,276(R1・R5)・外れ — effect にする 121(R1)。"
       :evidence "tests/data/public_api_known_violations.json(main edc3802d5b5f)— 名の正本はこの表で、この fact の数は書いた時の写し")
     (fact
       "既知の違反の表(同じ版)の境界の組と扱い — 基盤・道具の package 6,653(R10・R13)・effect の結果の型 857・effect の値の型 834・例外の型 214・handler の設定の型 115(R2 で許す物・R12)・workflow の DSL の言葉 66(doeff-conductor の dsl・R13)・class の形の handler 55(R4)・combinator 23(R6・R13)・handler と読める名(道具が読めない)19(handler の戻りの型を付けて目録に handler と読ませる)・未分け 16(R13)・CLI 4(R7 で残す物・R12)・Hy の macro 2(doeff-docker の with_handlers・doeff-events の event_loop — R13)。"
       :evidence "tests/data/public_api_known_violations.json(main edc3802d5b5f)")
     (fact
       "既知の違反の表(同じ版)の行の多い package — doeff-cluster 5,192(範囲の答え待ち)・doeff-agents 1,653・doeff-records 1,507・doeff-core-effects 1,273・doeff-claude-code 774・doeff-hy 735(範囲の答え待ち)・doeff-conductor 558。直しは行の多い決まりの範囲の package から、取り組み doeff-subpackages-effects-only の区切りごとに進める。"
       :evidence "tests/data/public_api_known_violations.json(main edc3802d5b5f)")
     (fact
       "公開の submodule(R5 の外れ)は、card ki-25d43146681e が既知の表に載せた 39 package の 731 行(決まりの範囲の 28 package に 410・範囲の答え待ちの 11 package に 321)。決まりの範囲の import の根のすぐ下の子は 267 個で、子を _<名> に替えれば下の module も隠れる。直しの分けは card ki-4bff1f81b0f4(stage 1〜3 の 31 枚)。"
       :evidence "tests/data/public_api_known_violations.json の (submodule) の行(doeff ec6311c0a の目録)・artifact 2026-10-28-doeff-submodule-hide-split.html(doeff 37467d478138 で 733 行・第 1 層の子 265 — その後 doeff-agents と doeff-hy-pytest が submodule を減らした)")
     (fact
       "持ち主は 2026-10-28 に、handler は印の付いた callable の値(中核の ProgramHandler)で、program に当てる公式の形は h1(h2(p))、WithHandler は中核の生の形で利用者向けの docs に出さない、一度きりの handler は Hy の handle の macro・使い回す handler は defhandler か handler を返す工場に名を付ける、doeff-core-effects の maybe・result・on_raise・absent_as・scheduled は中核の state() と同じ handler を返す工場として扱う、と決めた。subpackage が見せてよい物は effect と handler と handler を返す工場になり、工場は呼ぶと handler が返る事を構造(印)で確かめる。"
       :evidence "持ち主の発言 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA(2026-10-28)・card ki-bd3bec7b1360 の発言・card ki-25eecd63bc57")
     (fact
       "持ち主は 2026-10-30 に、handler はできるだけ工場の形にしない方針を示した。2026-10-28 の決定で工場とした scheduled は、2026-10-29 に工場の形 scheduled() と、旧い形 scheduled(p) を残す移し替えの層と、呼び手を書き換える道具を doeff の main に入れた(card ki-f2c2f789f5bb)が、この方針で呼び手の書き換えを取りやめ、doeff・agora-controllers・moneta の書き換えを戻した。scheduled は設定も呼びごとの状態も持たないので、ADR-DOE-API-002 R1 の maybe・result と同じく工場にしない。"
       :evidence "持ち主の発言 ci-1C69G7ED3693KC72N4XET8SZPQ・ci-HR642QPZJRX04MS5PFYCGPY0E4(2026-10-30)・card ki-8187e8827ad9・戻しの card ki-5b823877e005(doeff)・ki-7bff2b3b1ed3(agora-controllers)・ki-4250ebcc4069(moneta)")
     (fact
       "目録(doeff 19e34510931f の木・2026-10-29)は、戻りの型か return の形で handler を返す工場と読める定義を 39 package に 225 個(公開の行で 435)数えた。最小の引数で呼ぶと、202 個(引数なし 69・置き物 133)が印の付いた handler か handler の組を返し、21 個は呼ぶと例外(置き物を呼ぶ時に読む物・tmux の無い機体で tmux を探す doeff-agentic の tmux_handler など)、2 個 — doeff-conductor の make_scheduled_handler・make_offloaded_scheduled_handler — は印の無い (effect, k) の @do 関数(handler の body)を返した。maybe・result・on_raise・absent_as・scheduled は戻りの型が program(DoExpr・Program)なので工場と読まれず、引数なしで呼ぶと program が足りず、program を渡すと印の無い program を返す。"
       :evidence "tools/public_api_inventory.py の目録の行の理由(工場の行の末尾に、どう呼び・何が返ったか)・tests/data/public_api_known_violations.json の組「外れ — handler を返す工場の形に直す」と「足した名」の card ki-25eecd63bc57 の 6 行")
     (fact
       "持ち主は 2026-10-29 17:16 JST に、effect でも handler でもない program の helper — effect を出すだけの program を返す関数 — を見せてよいと決め、doeff-traverse の sequence を今のまま見せるとした。問いは、sequence を隠すか許すか(隠す向きでは doeff-cluster の 5 か所を for の loop に書き替える)だった。"
       :evidence "依頼書 lt-BPA7EJHY29RNHXHVEF7SPKPY81 の問い sequence の答え lt-R3TYRMMEM7YN0G9J9D2RZMVX3X・card ki-bd3bec7b1360 の発言・card ki-f20b18c2aad9")
     (fact
       "目録(doeff c344561a81e5 の木に R18 の判定を足した道具・2026-10-29)は、program を返す関数の公開の行 3,538 のうち 3,441 行(名 2,539)を helper の形(中で handler を被せず、effect に答えない)と読み、93 行を handler を被せる物、4 行を effect に答える物と読んだ。helper の形の行の多くは既知の表の外れの組に在る — 内側の module へ移す 2,163・handler の中へ入れる 1,024・effect にする 91。"
       :evidence "tools/public_api_inventory.py の目録の行の形と理由(helper を越える行の理由の末尾に、どの関数がどの名を読むか)・tests/data/public_api_known_violations.json の組")
     (fact
       "目録(doeff 6675fb4c72c1 の木・make sync の環境・2026-10-29)は、まだ問うていない道具の package 7 個の公開の行を数えた — doeff-vm-core 0(Python の module が無い)・doeff-linter 1(Rust の実行 file)・doeff-indexer 1(console script)・doeff-agentic-cli 1(Rust の実行 file)・doeff-effect-analyzer 64(submodule 6・console script 1・名 57)・doeff-domain 99(submodule 5・名 94)・doeff-test-target 180(submodule 29・名 151)。doeff-indexer と doeff-effect-analyzer はこの環境に入らず、目録は source の字面で読む — doeff-indexer の根が Rust の拡張から出す Indexer・SymbolInfo(doeff の根の doeff/cli/discovery.py が読む)は数に入らない。"
       :evidence "tools/public_api_inventory.py --package <dir> の目録の行(card ki-4c1d18a98579 の発言に名ごとの表)・packages/doeff-indexer/python/doeff_indexer/__init__.py・packages/doeff-indexer/src/python_api.rs")
     (fact
       "外れの組の helper の形の行を doeff 9c0707dd87a2 の目録で数え直すと 3,264 行・2,460 名(名は定義の数)。そのうち外の 12 repo(agora-controllers・merge-queue・moneta ほか)の origin/main か doeff の別 package が import する名は 155 名(271 行)だけ — 組で 内側の module へ移す 100・handler の中へ入れる 49・effect にする 6、repo ごとに agora-controllers 131・merge-queue 23・moneta 9 ほか。使わない 2,305 名は区切り 5 の隠す card が _ の下へ移す。"
       :evidence "card ki-3cf6e19b8fcf の発言(表 1・表 2・155 名の一覧)・artifact 2026-10-29-r13d-helper-counts.html")]
  :context
    [(interpretation
       "doeff の値は、handler を替えれば同じ program が test でも本番でも走る事にある。subpackage が手続き型の関数や client の class を見せると、利用者はその口を直に呼び、handler の差し替えの外で書く。effect と handler だけを見せれば、どの subpackage も effect を yield して handler を据えるだけで使える。")
     (interpretation
       "handler は印 _doeff_is_handler_fn の付いた callable の値(中核の ProgramHandler — program を受けて、包んだ program を返す)。中身は (effect, k) を受けて答える(Resume)か外へ渡す(Pass)body で、@handler・defhandler・stacked_handlers が印を付ける(ADR-DOE-CORE-003)。中核の state() のように、呼ぶと handler か handler の組を返す関数が handler を返す工場。program を受けて program を返す関数でも、印の無い物は handler でなく、呼んで印の無い値を返す物は工場でない — 数えるのは形の読みでなく印。")
     (interpretation
       "handler を値にすれば、program に当てるのは呼ぶだけ(h1(h2(p)) — 外から h1・h2 の順に包む)で、名を付けて使い回すのも渡すのも普通の値と同じ。中核の WithHandler(handler, program)は VM へ渡す生の形で、利用者が書く形でない。")
     (interpretation
       "型は effect と handler の一部: 値の型が無いと effect を作れず、結果の型が無いと答えを読めず、例外の型が無いと失敗を受けられず、設定の型が無いと handler を作れない。")
     (interpretation
       "公開の名の数え方は目録の道具の 1 か所が持つ: import の根の __init__ が出す名・path のどの部分も _ で始まらない submodule が出す名と、その submodule そのもの(R5)・[project.scripts] と entry point と maturin の bin。この ADR は数え方を別に持たない。repo の根の doeff(program・do・run・handler の核)は subpackage でなく、目録も数えない。doeff だけが import する doeff の中の部品(doeff-vm — R11)も同じ。")]
  :decision
    [(rule R1 "subpackage の公開 API は effect(EffectBase の型と、effect を作る関数)と handler(@handler・defhandler・stacked_handlers の、印の付いた値)と handler を返す工場(呼ぶと handler か handler の組を返す関数 — R3)と、名ごとに許した program の helper(R18)だけ(2026-10-26 の決まりを、2026-10-28 の決定 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA が工場まで、2026-10-29 の答え lt-R3TYRMMEM7YN0G9J9D2RZMVX3X が helper まで書き表した)。ほかの名(手続き型の関数・R18 で許していない program 関数・client や API の class・設定を読む関数・定数)は、名か module の path に _ を付けた内側に置くか、effect か handler か工場に作り直す。")
     (rule R2 "effect の値の型・effect の結果の型・effect と handler が投げる例外の型・handler の設定の型は、effect と handler の一部として公開してよい(2026-10-27・依頼書 lt-6KJ8EG0YPWXCQ2GRC5XNSQVNQM の問い types の答え lt-85SHMNQG7HG4AYHBER6V2BAKX6)。")
     (rule R3 "handler は印 _doeff_is_handler_fn の付いた callable の値(中核の ProgramHandler)で、中身は (effect, k) を受けて答えるか外へ渡す body(2026-10-28 の決定 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA)。handler を返す工場は、引数なしか最小の引数で呼ぶとその値(か、その値の list か tuple)を返す関数。印の無い関数は、program を受けて program を返しても handler と数えず、戻りの型を ProgramHandler と書いても呼んで印の無い値を返す関数は工場と数えない。目録の道具は工場と読めた名を最小の引数(既定値の無い引数ごとに中身の無い置き物)で呼んで印を確かめ、印の無い値を返す名を外れ(handler を返さない関数)と数える。呼ぶと例外の出る工場(置き物を呼ぶ時に読む物・機体に無い命令を探す物)は戻りの型の読みのまま。改めた前の形: 2026-10-27 の「handler は (effect, k) を受けて答える関数に限り、program を受けて program を返すだけの関数を handler と数えない」(combinator の書 lt-6JDFVKXCP8ZG9A7QY4XSCMACRM の問い maybe の答え lt-EMXC1HCMQ9CVW07RFP0CPR3EEZ)— 決定 (1) が handler を ProgramHandler の値と決めたので、形(program → program)でなく印で数える形に改めた。印の無い program → program の関数を handler と数えない事は変わらない。")
     (rule R4 "handler は class で書かない。名が Handler で終わり method で effect を受ける class の形の handler は、内側へ隠すのでなく doeff の handler(@handler・defhandler)に書き直して class を消す(2026-10-27・問い class-handler の答え lt-RMPE1XQ9RVWV4S8N0GTBE40Y61)。直しは card ki-3d948083b454(doeff-git)・ki-6b0772c6257e(doeff-agentic)・ki-6d58cb2f1a33(doeff-conductor)。")
     (rule R5 "公開の名は subpackage の import の根(__init__)からだけ出す。submodule は名に _ を付けて隠し、_ で始まらない submodule は外れと数える(2026-10-27・問い submodule の答え lt-YM5YVPMR3BAR0XR6DNEGG6PA9P)。subpackage ごとの直しの分けは card ki-4bff1f81b0f4。")
     (rule R6 "program を包む関数(combinator)は名ごとに決める(2026-10-27・問い combinator の答え lt-K1C6JM29MWVBHH9H7891JP4BG2)。doeff-core-effects の on_raise・absent_as は、中核の state() と同じ handler を返す工場として扱う(2026-10-28 の決定 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA)— 向きは on_raise(受け…)(p) のように、呼ぶと handler を返し、program はその handler に渡す形。on_raise・absent_as は工場の形に直した(2026-10-29・card ki-d27fd0acfe07 — 呼ぶと印の付いた handler を返し、doeff-hy の on-raise・absent-as の展開先もこの形)。maybe・result は設定も呼びごとの状態も持たないので、工場でなく印の付いた handler の値で、maybe(p)・result(p) と当てる(2026-10-29 の持ち主の答え・agora card ki-2d05bfc6ec94 — ADR-DOE-API-002 R1。2026-10-28 の決定では工場で maybe()(p) だったのを改めた。旧い呼び maybe()・result() は 1 つの版の間 DeprecationWarning を出して同じ handler を返す — ADR-DOE-API-002 R3)。4 つの旧い形 maybe(p)・result(p)・on_raise(p, 受け…)・absent_as(既定値, p) は、doeff の main を読む repo の呼び手を書き換えた後(card ki-2caf0f53603a)に消した(2026-10-29・card ki-53be25c354e4 — 旧い形は TypeError で断り、4 名は既知の表の組「外れ — handler を返す工場の形に直す」から消した)。scheduled は program に直に当てる handler のまま: 設定も呼びごとの状態も持たないので工場にせず、印 _doeff_is_handler_fn の付いた handler の値で、scheduled(p)(実装を選ぶ時は scheduled(p, implementation=…))と当てる(2026-10-30 の持ち主の方針 — handler はできるだけ工場にしない・発言 ci-1C69G7ED3693KC72N4XET8SZPQ・ci-HR642QPZJRX04MS5PFYCGPY0E4・card ki-8187e8827ad9 — ADR-DOE-API-002 R1 の maybe・result と同じ扱い)。2026-10-28 の決定では工場で scheduled()(p) だったのを改めた: 2026-10-29 に入れた工場の形 scheduled() と移し替えの層と呼び手の書き換えの道具(card ki-f2c2f789f5bb)は消し、scheduled() は program が足りない TypeError になる。scheduled の 2 行は印で handler と読まれるので既知の表の組「外れ — handler を返す工場の形に直す」から消し、組は空になって消えた。program に handler を被せていた 8 名(既知の表の境界の組の 16 行)は、持ち主の決定(2026-10-30・card ki-c72b3906869b — R3・R16 で向きが決まっている)で工場か handler の値の形に寄せた: doeff-conductor の make_blocking_scheduled_handler・make_async_scheduled_handler(fn を受け、全部の effect に fn(effect) で答える handler を返す)と doeff-notify の testing_handler・build_testing_handler(記録の先 NotificationCapture を受ける)は名のまま工場にし、doeff-core-effects の run_apart は設定も呼びごとの状態も無いので工場でなく名のまま印の付いた handler の値(run_apart(p) — ADR-DOE-API-002 R1)にし、doeff-agentic の with_agentic_effectful_handlers(p, …) はもう在る工場 agentic_effectful_handlers(…)(p) へ、with_handlers(p, handlers)(doeff_agentic.runtime)は doeff の stacked_handlers(*handlers)(p) へ寄せて名と submodule を消した。doeff-records の ready_handlers は handler を被せる関数でなく、検の殻の用意の program(書き手の名 → handler をそのまま返す)なので、工場にせず内側の _ready_handlers へ移した。doeff の main を読む外の repo の呼び手は 8 名とも 0 だったので、移し替えの層を置かずに替えた。改めた前の形: 2026-10-27 の「maybe と result は今は公開の関数として許す決まりの例外」(書 lt-2GXXR6ES9CCA3RZ76KQBZ1HK03 の問い result の答え lt-ZF2RXKY95518G3280NRRP32EFS)— 決定 (3) が 5 つを工場と決めたので、例外を外して工場の側へ移した。writer_log は記録を読む effect ReadWriterLog と handler に作り直した(問い writer-log の答え lt-FVGDH8R59WSBCJ8ME5SVC4G06X・card ki-256e89367dd0)。残りの 6 個のうち closing_links・sequence・try_call・validate は R18 の program の helper として許し、check・perform の 2 個は型 Check・Perform にして関数を消した(R19)。")
     (rule R7 "人が打つ CLI コマンド(doeff-agents・conductor・doeff-flow・doeff-agentic-tui)は残し、中身は subpackage の effect を出す program を handler の下で走らせるだけにする。CLI コマンドのための client と API の class は subpackage の内側に置く(2026-10-27・書 lt-6ZJK3DKWFNBK1YVNGH1DNM72FC の問い cli-user の答え lt-57AKP3A28CQN8VVWH74YH8N8S5)。直しは card ki-307f29018559・ki-1ef3718c89b3・ki-7e6ce5db22d4。")
     (rule R8 "code は CLI コマンドのサブコマンドで process を起こさない。常駐の process は役ごとの Python の module の入口に分け、起動は effect にして、handler が sys.executable -m <module> で起こす(PATH を見ない)。doeff-agents の CLI コマンド doeff-sessionhost は消した(2026-10-27・書 lt-6WY2RE7B77YNNRB3HYWXD3778N の問い sessionhost-launch の答え lt-72NHAT8F7QDV6JER8GTDACPKMB・card ki-bb337cfd0336)。")
     (rule R9 "subpackage は __version__ を持たない。版は importlib.metadata.version で読む(2026-10-27・書 lt-2GENAXPWCYF0FFHSX8Q6K5SR4V の問い version の答え lt-1YE9759TCCZ7JEWP78GV2T4H8Q・card ki-d5071356ca9b)。")
     (rule R10 "effect と handler を出す物でない道具の package 12 個は、まとめて範囲に入れも外しもせず、package ごとに決める(2026-10-27・問い infra の答え lt-8V00BBVKMV2CVHB45S00A3558Z)。決まった物 — doeff-vm: 利用者の入口は doeff の根で、doeff_vm を import するのは doeff の中だけ。根に無い handler を書く型は根に足し、数を測る・設定する関数 9 個は effect と handler にする(書 lt-FVDJW8KVXY4ZDF371898PJAM1C の答え lt-XM33P1YN6QBWX9VFMHT0T439FA・card ki-ff728b00369a・ki-27e8ea225b62)。doeff-vm の範囲は R11(doeff の中の部品として目録の範囲の外)。doeff-hy の macro: effect・handler・program を書く群(defeffect・defhandler・defk・<- ほか 14)と deftest と土台の群(defrecord・val・var・deff ほか 10)は見せる。値に替える群は、absent-as・on-raise を R6 の工場に、check・validate を R13 の答えに合わせる。conductor の workflow の macro 13 個と defsystem は doeff-conductor と doeff-cluster へ移す(書 lt-ZR6B2AN9DE1DN8534M35JQBCJJ の答え lt-GXXY5TVWBHJW4ZCBDTCRN68XZS・card ki-f2107259b141)。doeff-hy-pytest: 見せる名は pytest11 の plugin の登録と、test ごとの宣言 2 個(declare_step_budget・declare_process_tree_cpu)の 3 個に絞る。測りの中の class と関数は内側へ移し、外の repo は plugin が出す要約の行を読む形に直す(書 lt-Y7V79JHX361ASZENVT1HM9V2ND の答え lt-796ZF4G6CQ6TSHS5JDDRP09P1K・2026-10-28 — 直しの card は持ち主が切る)。doeff-cluster は R15。doeff-vm-core と doeff-linter は R23。doeff-effect-analyzer は R24。doeff-test-target は R26(packages の外へ移した)。doeff-indexer は R27。doeff-agentic-cli は R28 で消した。doeff-domain は R29。最後の 1 package の doeff-adr は R33(R13 (b) から外した)。")
     (rule R11 "範囲は packages/ の下の package のうち、doeff の中の部品を除く全部。doeff の中の部品は、doeff の根の package(doeff/)だけが import する package で、今は doeff-vm だけ(R10 の答え lt-XM33P1YN6QBWX9VFMHT0T439FA — 利用者は VM の型を doeff の根から読み、doeff の subpackage は VM の内側の物を doeff._vm から読む)。部品は利用者が import する subpackage でないので、doeff の根と同じく目録の道具が数えず(tools/public_api_inventory.py の DOEFF_PARTS)、既知の表にも載せない(2026-10-30・card ki-9c326052f21c — 表の範囲「範囲の答え待ち」・組「境界 — 基盤・道具の package」の doeff-vm の 64 行(submodule 1・名 63)を消した)。数えない代わりに、同じ表の test が、doeff の外の file(packages/ の下の部品の外の package・examples・docs/adr の Hy)が部品の import の根を import しない事を見る — import・from・Hy の import と require・importlib.import_module や pytest.importorskip に渡す名の文字列を読む(law a-doeff-part-is-imported-only-by-doeff)。doeff の根の package と doeff の検(tests/)は doeff の中で、VM を直に読んでよい。repo の中の benchmarks(VM を測る道具)・publications(出した記事)・docs の設計の証拠(過去の記録)も数えない。doeff の外の repo は doeff の検から見えないので、その書き換え(2026-10-30 の数えで 8 repo・69 か所 — agora-controllers 50)と repo ごとの見張りは card ki-de7e0cc9c148 が持つ。doeff-vm の中身の Rust の crate doeff-vm-core は Python の module を持たず、R23 のまま「決まりの範囲」に置く。既知の表の範囲「決まりの範囲」の 36 package には今から当てる。「範囲の答え待ち」の package は今は 0 で、最後の doeff-adr は R13 (b) の答えで R33 のとおり「決まりの範囲」へ移した(答えの出ない package を足す時は、答えが出たら表の範囲と組を答えに合わせて改める — 改める card は持ち主が切る)。答えで「決まりの範囲」へ移した物: doeff-hy は R14、doeff-cluster は R15、doeff-vm-core と doeff-linter は R23、doeff-effect-analyzer は R24、doeff-indexer は R27、doeff-domain は R29、doeff-adr は R33。doeff-hy-pytest は R10 の答えのとおり「決まりの範囲」に在る。packages の下から外した物: doeff-test-target は R26 で移し、doeff-agentic-cli は R28 で消した。改めた前の形: 2026-10-27 の「範囲は packages/ の下の package の全部。『範囲の答え待ち』の 12 package は、R10 の答えが出た物(doeff-vm・doeff-hy・doeff-hy-pytest)から表の範囲と組を答えに合わせて改める」— R10 の答えが doeff_vm を import するのは doeff の中だけと決めたので、doeff-vm を範囲に入れず、doeff の中の部品として範囲の外に置いた。")
     (rule R12 "強制は 1 か所: tests/test_public_api_known_violations.py が tools/public_api_inventory.py の目録を package ごとに 2 つの表と突き合わせる(card ki-aaaa56621c5a)— 既知の表(違反の表 tests/data/public_api_known_violations.json — 外れと境界だけ)と許した物の表(tests/data/public_api_allowed.json — 決まりが名ごとに許した名)。どちらの表にも無い外れが在れば赤・表に在るのに目録に無い名が在れば赤(どちらの表でも)・既知の表の「名」の組は減るだけ。足すしか無い外れは既知の表の「足した名」に訳と決め(card・依頼・発言の id)を 1 行ずつ書く。許した物の表は 1 行ずつ組と決め(card・依頼・発言の id)を持ち、決めの id つきで足せる — 決めの id の無い行・既知の表と同じ名の行は赤。既知の表は許した物の組を持たず(置くと赤)、外れと境界を直し切れば空になれる(持ち主の決定 2026-10-30・card ki-5b3b2320de40 — 区切り 6 の条「表が空」を字のとおり満たす形。前は許した物も既知の表の組に置いた)。R3 の工場の確かめ(呼んで印を見る)も目録の道具の中に置き、呼んで印の無い値を返す名は同じ照合で外れになる(card ki-25eecd63bc57)。R18 の helper の確かめ(中を読む)も目録の道具が持ち、許した物の表の組「許した物 — program の helper」の名の形が helper でなければ同じ test が赤にする。許した物の表の組は、目録で形を確かめる組だけを置ける(card ki-f20b18c2aad9)— 今は「許した物 — program の helper」(R18)・「許した物 — Hy の macro」・「許した物 — CLI コマンド」(R31)の 3 つ。決まりの範囲の Rust の拡張を持つ package を目録が import で読めない(字面で読んだ)時も同じ test が赤にする — 字面の読みは入口が拡張から出す名を数えない(R27・card ki-1e51e218527e)。この ADR は別の検を作らない。R2 の型・R7 の CLI コマンドのように答えで許した物も、目録の道具が形を確かめる許す組を足すまでは既知の表の境界の組に残し、隠して直さない — 許す組を足す card が、その行を許した物の表へ決めの id つきで移す。")
     (rule R13 "未決(答えが来たら持ち主がこの ADR に条を足し、既知の表の範囲と組を改める card を切る): (a) なし — combinator の残りだった doeff-validation の check・perform は R19 で決めた(closing_links・sequence・try_call・validate は R18)。(b) なし — 道具の package の最後の doeff-adr は R33 で決めた(2026-10-30 01:09 JST・依頼書 lt-6SE07X4256P323ZGZVNSEF9M95 の問い adr-scope の答え lt-RA4FZ731JNZQ6JEGVAYD35XCAZ — 範囲に入れる。前の書 lt-RD6GWB97WRVMESGDWCHHZDZJW4 は差し戻され、1 通 1 問で問い直した。get_adr は R20・adr_ids は R21・register_semgrep_enforcement と assert_semgrep_enforcement は R22・assert_adr_contract と assert_all_adr_contracts と register_deftest_enforcement は R30・register_adr・clear_registry・enforcement_ids・get_enforcement は R32 で決めた)。ほかの道具の package も答えが出た(doeff-vm は R11 で doeff の中の部品として範囲の外に置いた・doeff-cluster は R15・doeff-hy-pytest は R10・doeff-vm-core と doeff-linter は R23・doeff-effect-analyzer は R24・doeff-test-target は R26(答え lt-H74EV6FXSHXAWRP91037VW86QD)・doeff-indexer は R27(答え lt-ZDN45RSNPV16BKSM997GGZ9CVB)・doeff-domain は R29(答え lt-FP17P0A4CPBC1RJCF9BFBVF4WV)で決めた。workflow の Rust の CLI の package は R28(答え lt-T9TTHBXF5YK0B1FBJGFCZF6CZ1)で消した)。doeff-test-target を含めた 4 個の名ごとの分け — 答えの出た条で決まる名と問いの要る名、用途・使い方・呼び手の数 — は card ki-4c1d18a98579 の発言に在る。(c) 問いのまだ無い境界 — doeff-conductor の workflow の DSL の言葉(doeff_conductor._dsl の 66 行)・未分けの 16 行(doeff-hy の外の Hy の macro の置き場と、doeff-hy の CLI doeff-hy-check と pytest の plugin の module は R31 で決めた)。(d) なし — 外れの組に在る、helper の形の program 関数(2026-10-29 の目録で 3,278 行 — 内側の module へ移す 2,163・handler の中へ入れる 1,024・effect にする 91)は、2026-10-29 22:08 JST の答え lt-7EK027YNFXTP27QE60J7Q686CZ(依頼書 lt-VMXVKDP64YX0XYAH9YAXTDC9TA の問い helper-155 — 使う名だけ許す)で R25 に決めた: 外の repo か doeff の別 package が使う 155 名は R18 で名ごとに許し、使わない 2,305 名は R1・R5 のとおり内側へ移す。")
     (rule R14 "doeff-hy は範囲「決まりの範囲」に入れる(2026-10-29・R10 の答え lt-GXXY5TVWBHJW4ZCBDTCRN68XZS の macro の外を、持ち主の段取りで R1・R2・R5 のとおりと決めた — card ki-2526a4b4f561)。macro は R10 の群のとおり、macro を出す 3 つの submodule(doeff_hy.macros・doeff_hy.record・doeff_hy.handle)から見せる — Hy の require が module の path で macro を読むので、この 3 つは R5 の外の境界に置く。macro の外の名は R1・R2・R5 のとおり: R2 の型は入口から出してよく、残りは内側の module へ移し、doeff_hy と doeff_hy_bytecode_guard の下の残りの submodule 50 個は名に _ を付けて隠す。隠した後は、submodule に足した名が既定で公開にならない。直しの分けは card ki-2526a4b4f561 の子。3 つの macro の module が出していた macro でない名 36 個(既知の表の 43 行 — 展開の部品の import・定数 HELPERS_NAME・class RuntimeDo・defrecord の :check の展開が呼ぶ require_check)は内側へ移した(2026-10-30・card ki-a28c20b93638): import は _ の別名で束ね、HELPERS_NAME と RuntimeDo は名に _ を付け、require_check は内側の Python の module doeff_hy._record_check へ移した(展開は doeff_hy._record_check.require_check を呼ぶ)。外の repo が 3 つの module の path から読むのは macro だけで、移した名を読む file は 0 だった。今の 3 つの module の目録の名は Hy の macro だけ。")
     (rule R15 "doeff-cluster は範囲「決まりの範囲」に入れる(2026-10-29・書 lt-3GGRA8T615V785SZ65CZ6JGZ1D の問い cluster-scope の答え lt-G256RJK3A95G4N7R5XC5FEJBVP — hide・card ki-2526a4b4f561・ki-362df4037544)。名は R1・R2・R5 のとおり: 外の repo が使う名(書の数え — 公開の名 3,443 個のうち 423 個)だけを入口から見せ、そのうち effect にする名と handler の中へ入れる名は後の card で直す。外が使わない名は内側の module へ移す。入口は R5 のとおり import の根 doeff_cluster に置く — 今の doeff_cluster は根の __init__ を持たない Hy の namespace package なので、card ki-299be2ea4a13 の道具が根に遅延の import の入口を作り、根のすぐ下の区画(coordinator・foundation・record_store・shared・sim・worker)を _<区画> へ移して、下の submodule(2026-10-29 の目録で 217 個)をまとめて隠す。書の「選んだ後の code」は区画の path(doeff_cluster.sim)から読む形を見せたが、R5 と目録の道具と表の test は import の根から出す名で数えるので、使い手の import は (import doeff_cluster [sim-cluster StartWorker]) になる。macro defsystem(R10)は根のすぐ下の公開の module doeff_cluster.macros から見せ、R5 の外の境界に置く — Hy の require が module の path で macro を読むので(R14 と同じ訳)。今の doeff_cluster.shared.entry.macros から移すのは shared の区画の段 1。隠した後は、submodule に足した名が既定で公開にならない。直しの分けは card ki-2526a4b4f561 の子(区画ごとの段 1・使い手の repo の段 2・移し替えの module と表の行を消す段 3)。")
     (rule R16 "handler を program に当てる公式の形は h1(h2(p)) — handler の値を呼んで包む(2026-10-28 の決定 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA)。中核の WithHandler(handler, program)は VM へ渡す生の形で、利用者向けの docs と例には出さない。今の docs の WithHandler の書き替えは持ち主が card を切る。")
     (rule R17 "その場で一度だけ当てる handler は Hy の handle の macro(match のように effect ごとの節を並べてその場で当てる — doeff_hy.handle・card ki-fb1c0fb41ff5)で書き、使い回す handler は defhandler か handler を返す工場に名を付けて出す(2026-10-28 の決定 ci-TDTZ23GS70F1VFM0DV183G9VQQ〜ci-AFX0HEJAT7SAMANA3YCPKE9RJA)。subpackage が見せるのは名を付けた方(R1)。")
     (rule R18 "effect を出すだけの program を返す関数(program の helper)は見せてよい(2026-10-29 17:16 JST・依頼書 lt-BPA7EJHY29RNHXHVEF7SPKPY81 の問い sequence の答え lt-R3TYRMMEM7YN0G9J9D2RZMVX3X)。helper と数えるのは次の 3 つを満たす関数: (1) program を返す — @do・defk の関数か、戻りの型が program(Program・DoExpr ほか)の関数。(2) 自分で effect を受けて答えない — 中で handler の制御(Resume・ResumeThrow・Transfer・TransferThrow・Pass)を読まない。(effect, k) を受ける関数は R3 の handler で、helper でない。(3) handler を被せない — 中で WithHandler・with_handlers も、handler の値・作り手(handler・stacked_handlers)・handler を返す工場も読まない。中は、その関数と、中で読む同じ package の関数を辿った全部で見る(呼ぶ program の中で例外を受けて投げ直すのは、effect に答える事でないので helper のまま)。中を読めない関数(Python の関数でない物)は helper と数えない。目録の読みは中の名を global の値か属性の名で見て、同じ package の関数だけを辿るので、引数で受けた handler を当てる形・module の容器や class と instance の属性から読んだ handler を当てる形・別の package の関数が被せる形は見えず、helper と読む。だから helper は名ごとに許し、許す名の中は人が読む。helper は許した物の表(tests/data/public_api_allowed.json)に組「許した物 — program の helper」と許した決めの id をつけて名ごとに置き(後から見せる helper も同じく決めの id つきで足す — card ki-5b3b2320de40。前は既知の表の組と「足した名」の欄「組」に置いた)、目録の道具がその名の形を確かめて、helper の形でなければ赤にする(R12)。形が helper でも、許した物の表に置いていない program 関数は外れのまま(R25)。今許す名: doeff-traverse の sequence・try_call(答えのとおり)と、同じ形の doeff-core-effects の closing_links・doeff-validation の validate(card ki-f20b18c2aad9 が同じ条で扱った)と、外の repo か doeff の別 package が使う 155 名(R25)。check と perform は program を返さないので helper でなく、R19 で型にした。")
     (rule R19 "doeff-validation の check と perform は関数でなく型にする: 検査の指定は型 Check(旧 CheckSpec)、効果の実行の印は型 Perform(旧 Performed)で、利用者は Check(述語, 引数…, reason=…)・Perform(program) と型を直に書く(2026-10-29 17:33 JST・依頼書 lt-AXDTX0Z4ZJTG2Z53AHJ9Y5HTWB の問い check-perform の答え lt-MHFWEYBQYCC2PQYR84VKXBAET8 — 型にする・card ki-2750cc5e5209)。述語が callable か・Perform の値が program か effect かの確かめと、式の字面の作りは型の作り方が持ち(どちらも外れれば作る時に TypeError)、関数 check と perform は公開の名から消した。2 つは validate の項目の値の型として R2 の型に数え、R12 のとおり、目録の道具が R2 の型を許す物と数えるまでは既知の表の「足した名」に置く。Hy の利用者は macro の check を書き、その展開も型 Check を作る(各引数は評価を項目の中へ遅らせる thunk つきの CheckArgument で渡し、Check はそれをそのまま使う)。")
     (rule R20 "doeff-adr の get_adr(登録簿の ADR を id で引く関数)は、effect GetAdr と、登録簿から答える handler を返す工場 adr_registry にした(2026-10-29 17:34 JST・依頼書 lt-TNNNQAXTY6XY4RAKWDDFX62NSM の問い get-adr の答え lt-82V6XBGCCR214RCF3SRKSZGTP5 — effect にする・card ki-24a2bca4339f)。登録簿を引く本体は内側の _get_adr に置いた。公開の関数 get_adr は R6 と同じ順で、新しい形と同じ答えの移し替えの層として残し、doeff の main を読む repo の呼び手を GetAdr へ書き換えた後(card ki-f2d54a67497b — agora-controllers は同じ変更で doeff の pin を上げた)に消した — 既知の表の 2 行(doeff_adr と doeff_adr._registry)も消した(2026-10-29・card ki-c46e83ebd6ac — card ki-24a2bca4339f から分けた消しの card。構成のレビューの所見どおり、消す名の使い手を先に直した)。adr_registry() は process の登録簿を答える時に読み、adr_registry(specs=[AdrSpec …]) は渡した列だけから答える(列に無い id は外の登録簿へ落ちずに KeyError)。内側に据えた方が先に答えるので、test は外の既定の handler の下で別の表に差し替えられる。deftest の下に据えるのは、doeff-adr が handler の組を選ばない決まり(doeff-adr の README)のまま、project の doeff_interpreter fixture — doeff は docs/adr/conftest.py が adr_registry() を据える。外の repo(agora-controllers・agora・custody)の呼び手の書き換えは card ki-f2d54a67497b。")
     (rule R21 "doeff-adr の adr_ids(登録簿の ADR の id を並べて返す関数)は、effect AdrIds にし、R20 の工場 adr_registry の同じ handler が答える(2026-10-29 19:05 JST・依頼書 lt-SNXDP773DP61WQ8S3D5HSHW2B1 の答え lt-NJMPGF51C0FBF49SC430JWEQ82 — effect にする・card ki-2d28425e0d40)。adr_registry() は process の登録簿の id を答える時に並べ、adr_registry(specs=[AdrSpec …]) は渡した列の id だけを並べる(GetAdr と同じ表を読む)。並べる本体は内側の _adr_ids に置いた。公開の関数 adr_ids は R20 の get_adr と同じ順で(消す名の使い手を先に直す)、まず AdrIds と同じ答えの移し替えの層として残し(doeff L3079)、doeff の main を読む repo の呼び手(agora の docs/adr/defadr_0007_governance_charter.hy と custody の docs/adr/defadr_0008_auth_custody.hy の 1 関数ずつ — agora L6159・custody L74。agora-controllers に呼び手は無い)を AdrIds へ書き換えた後に、同じ card で消し、既知の表の 2 行(doeff_adr と doeff_adr._registry)も消した。")
     (rule R22 "doeff-adr の register_semgrep_enforcement(Semgrep の検を表に載せる関数)と assert_semgrep_enforcement(semgrep を走らせて見本の当たり外れを確かめる関数)は、effect RegisterSemgrep・AssertSemgrep と、2 つに答える handler を返す工場 semgrep_enforcements にした(2026-10-29 19:05 JST・依頼書 lt-WVC8PTVD0E022XXMKP1J98ACDP の問い register-semgrep の答え lt-KY48MR4KP2N0GS9MQCCJTJMH55 と、依頼書 lt-5CQZ1TMGZSCQ01PXH8JY2JK3DN の問い assert-semgrep の答え lt-19276K37Z3TCCRTBMXWBMMXVMN — どちらも effect にする・card ki-2a549274055c)。本体は内側の registry._register_semgrep_enforcement・registry._assert_semgrep_enforcement に移した。公開の 2 つの関数は R20 と同じ順で(消す名の使い手を先に直す・構成のレビューの所見)、まず新しい形と同じ答えの移し替えの層として残し(doeff 4bd260a69)、doeff の main を読む repo の直の呼び手(agora-controllers の scripts/semgrep_fixture_tree.hy と controllers/{kanban,durable}/tests/test_semgrep_fixtures.hy — agora-controllers は doeff を pin せず兄弟の main から読むので、先に消すと 3 file が import の誤りになり全部の branch の着地の検が止まる)を effect へ書き換えた後に(card ki-ac39cb3c0bcd・agora-controllers cef8e6e88a。agora と custody に呼び手は無い)、card ki-baf84c90f3df で 2 つの関数を registry と入口から消し、既知の表の 4 行(doeff_adr と doeff_adr._registry の 2 名ずつ)も消した。Semgrep の検を表に載せる口と確かめる口は effect RegisterSemgrep・AssertSemgrep だけで、本体の _register_semgrep_enforcement・_assert_semgrep_enforcement は内側に残る。handler は R20 の adr_registry と分ける: AssertSemgrep は外の process(semgrep)を起こすので、ADR を読むだけの handler の組に混ぜない。semgrep の process はこの handler が AssertSemgrep に答える時に起こす。semgrep_enforcements() は process の登録簿に載せて読み、semgrep_enforcements(table={…}) は渡した辞書に載せて読み(辞書に無い id は外の登録簿へ落ちずに KeyError)、semgrep_enforcements(semgrep=…) は渡した実行 file(str か Path・無ければ AssertionError)で semgrep を起こす。載せと検の決まった失敗(AssertionError・KeyError・ValueError)は TransferThrow で effect を出した所へ投げ返す。内側に据えた方が先に答えるので、test は program の一部だけを別の表や別の semgrep で走らせられる。macro defsemgrep の展開は、載せを import の時に、検を生まれる test の中で、この effect をこの handler の下で走らせる — project の doeff_interpreter fixture に頼らないので、外の repo の defsemgrep は doeff の版を上げるだけで動く。")
     (rule R23 "doeff-vm-core と doeff-linter は範囲「決まりの範囲」に入れる(2026-10-29・答えの出た条 R1・R7 で決まる — 問いを出さずに決めた・card ki-4c1d18a98579)。doeff-vm-core は Python から import できる module を持たない Rust の crate(doeff-vm の中身)で、公開の名は 0 — 直す名は無く、範囲に入れれば Python の面を足した時から R1・R5 が当たる。doeff-linter は Python の module を持たず、公開の名は Rust の実行 file doeff-linter の 1 個だけ。人が打ち、commit の hook が呼ぶ命令なので、R7 のとおり残し、既知の表の組「境界 — CLI」に置く(R12)。R7 の「中身は subpackage の effect を出す program を handler の下で走らせるだけ」は、CLI コマンドが subpackage の effect と handler を迂回して状態を読み書きする別の口にならないための条。doeff-linter は effect も handler も持たない静的な検査の道具で、迂回する相手が無いので、Rust の実行 file を doeff の program に書き替える直しは無い(workflow の Rust の CLI の package は doeff-agentic の effect と handler が答える記録を Rust から直に読んだので、同じ読みでは決まらず R13 (b) に残した — 後に R28 で消した)。R7 の書 lt-6ZJK3DKWFNBK1YVNGH1DNM72FC は前提で道具の package 12 個の CLI コマンドを別の書に回していたので、R7 の答えの文は doeff-linter を決めていない — R23 は card ki-4c1d18a98579 の頼み(答えの出た条に R7 を挙げた)に依り、R7 の目的で決めた延長で、持ち主が覆せる。")
     (rule R24 "doeff-effect-analyzer は範囲「決まりの範囲」に入れ、解析の関数を effect と解析の handler にした(2026-10-29 22:15 JST・依頼書 lt-4GATVKA4BMSJMJSRPZ1HFX42J9 の問い analyzer の答え lt-646XDCG0CJXMX7JP6558JD426W — effect にする・答えの型は見せる・card ki-593f9f44c501)。入口 doeff_effect_analyzer が出すのは、effect AnalyzeProgram(Program の関数が出す effect → ProgramEffects)・AnalyzeHandler(handler が答える effect と節が出す effect → HandlerEffects)・AnalyzeEnv(env の工場の handler の列)・CheckCoverage(env と、Program が自分で据えた handler が全部の effect に答えるか → Coverage)と、4 つに答える handler を返す工場 effect_analysis と、R2 の型(答えの型 ProgramEffects・HandlerEffects・Coverage・Gap・Basis と、CheckCoverage の欄の値の型 SuppliedDeclaration・FoldCarried)だけ。effect_analysis(result_cache=True) は、そこで読む Program の関数の CheckCoverage の答えを、依る module の file の中身が同じ間 disk から読む(前の関数 cached_result の役 — 鍵の名を引く importable_name も handler の中へ入れた)。運ばれた Program を出した所で数える運び手は、前の関数 runs_where_performed と呼び手の述語(include)に代えて、値の型 FoldCarried(declared・names)で渡す。effect にするまでもない名は内側へ移した: qualified_name(型の import の名 — 呼び手は __module__ と __qualname__ で綴る)・module_ast(ADR-DOE-ANALYZER-001 の検が内側から読む)・observe_expansions(process に 1 つの Hy の展開の見張りの口 — program の中で頼む物でないので effect にせず、doeff の中の doeff-hy-pytest の plugin だけが内側の _program_effects から読む)。R18 は program を返す関数の条なので、この 3 つには当てない。submodule 6 個(cli・env_places・handler_effects・hy_expansion・program_effects・result_cache)は R5 のとおり _ を付けて隠し、外が使わない 50 名は内側に置いた(Rust の core の analyze・analyze_symbol も入口から外し、_native に残す)。CLI コマンド doeff-effects は R7 のとおり残し、中身は同じ effect を effect_analysis の下で走らせる(_cli.main)。古い path の program_effects と handler_effects は、R20 と同じ順で(消す名の使い手を先に直す)まず外の repo が import する 5 名(analyze_program・check_coverage・qualified_name・runs_where_performed・ProgramEffects)だけの移し替えの層として残し(doeff 4579b86aa)、doeff の main を読む外の repo の呼び手(agora-controllers の検 3 file — agora-controllers 6edd72897 と、merge-queue の検 1 file — doeff の pin を 4579b86aa へ上げた merge-queue 1a0a489a)を effect AnalyzeProgram・CheckCoverage と FoldCarried へ書き換えた後に、card ki-be7d74e0f2e6 で 2 つの module を消し、既知の表の外れの組(effect にする・submodule を _ で隠す・内側の module へ移す)も消した。doeff の中の呼び手(doeff-cluster の foundation-closure・doeff-events と doeff-records の検 3 file・CLI)は effect へ書き換えた — foundation-closure は解析の handler を自分で据えるので、その呼び手は handler を足さない。目録の道具は maturin の package の source の dir を sys.path の最後に置き、入っていない純 Python の入口を字面でなく import して数える(入れた build が在ればそれが先)。")
     (rule R25 "外れの組に在る helper の形の program 関数は、外の repo か doeff の別 package が使う名だけを R18 で名ごとに許し、使わない名は R1・R5 のとおり内側へ移す(2026-10-29 22:08 JST・依頼書 lt-VMXVKDP64YX0XYAH9YAXTDC9TA の問い helper-155 の答え lt-7EK027YNFXTP27QE60J7Q686CZ — 使う名だけ許す・card ki-9261e8b524d8)。使う名は card ki-3cf6e19b8fcf が doeff 9c0707dd87a2 の目録と外の 12 repo の origin/main で数えた 155 名(定義の数。表の行で 271 — doeff-cluster 62・doeff-records 39・doeff-core-effects 29・doeff-hy 8・doeff-events 6・doeff-agents 3・doeff-claude-code 3・doeff-gemini 2・doeff-openai・doeff-openrouter・doeff-system-one 1 ずつ)で、既知の表の組「外れ — 内側の module へ移す」181 行・「外れ — handler の中へ入れる」75 行・「外れ — effect にする」15 行から組「許した物 — program の helper」へ移した(その後 card ki-5b3b2320de40 が、この 271 行を決め lt-7EK027YNFXTP27QE60J7Q686CZ つきで許した物の表 tests/data/public_api_allowed.json へ移した — R12)。同じ定義を別の module が出し直す行も同じ名として移した。名の一覧は card ki-3cf6e19b8fcf の発言に、正本は許した物の表に在る。R18 のとおり目録の道具がこの組の名の形を確かめ、helper の形でなくなれば表の test が赤にする(R12)。doeff-cluster の 62 名は R15 の「外の repo が使う名」に当たり、入口から見せる。tools/hide_submodules.py は組が外れでない名と許した物の表の名を入口へ出すので、まだ隠していない submodule の名は、隠す card の hide が入口へ出す。同じ名の違う定義が 2 つ在る 4 組(doeff-records の metric_word・doeff-cluster の stopped・kube_headers・file_sha256)は、道具が入口へ足さずに「ぶつかり」と出すので、隠す card が片方の名を改めるか 1 つを選ぶ。既に段 1 で _ の下へ移した子の名 36 個(doeff-hy の wire と json_lines と http の 8・doeff-records 11・doeff-core-effects 8・doeff-events 4・doeff-claude-code 3・doeff-agents 2)は、段 1 の hide が外れとして _ に残したので入口が出していない — 段 3 で移し替えの module を消す前に入口へ出し直す(card は持ち主が切る。先に段 3 が消すと許した物の表の行も消え、出し直す名は許した物の表に決めの id つきで足し直す)。外の repo はこの 36 名を今も古い path(移し替えの module)から読み、_ の path から読む file は 0 なので、外の repo の import を入口へ戻す書き換えは要らない — 段 2 の rewrite が、入口が出す名を入口へ向ける。使わない 2,305 名は外れの組に残り、区切り 5 の隠す card が _ の下へ移して段 3 で表の行を消す — effect にする・handler の中へ入れる直しの card は要らない(R1 は内側に置く事でも満たす)。入口から直に出していた使わない 50 名は card ki-b3116755a24c が外した。外の repo が後から使い始める helper は、名ごとに許した物の表に組「許した物 — program の helper」と決めの id をつけて足す(R18)。")
     (rule R26 "doeff-test-target は利用者に配る subpackage でなく、doeff-effect-analyzer の解析の見本なので、packages の下から doeff-effect-analyzer の test の dir の packages/doeff-effect-analyzer/tests/fixtures/doeff_test_target へ移した(2026-10-29 23:47 JST・依頼書 lt-E5Y7J8S58RZXKT3M57XYJQXW8F の問い test-target の答え lt-H74EV6FXSHXAWRP91037VW86QD — 外へ移す・card ki-0e4728cb69c6)。見本の中身は変えない。読み手は Rust の検 tests/effect_tracking.rs(見本を一時の dir へ写して解析する)と、見本が今の doeff の上で動く事を確かめる検 3 file(tests/python の test_fixture_package_* — 走らせる helper は fixture_package_run_support)。見本は package として入れず、検が tests/fixtures を sys.path に置いて読む。tests/fixtures の下は pytest が集めない(tests/conftest.py の collect_ignore — 見本の effects/test_effects.py は module の名で検ではない)。packages の下に無いので目録の道具は数えず、既知の表の行(範囲「範囲の答え待ち」・組「境界 — 基盤・道具の package」の submodule 29 行と名 133 行)は表から消した。")
     (rule R27 "doeff-indexer の索引を引く口は、effect FindSymbols(module の path・印の語・種類 → 答えは SymbolInfo の tuple)と、Rust の索引器で答える handler rust_indexer にした(2026-10-29 22:16 JST・依頼書 lt-S4R44DQ5ZPJZD986TY812Q2DW9 の問い indexer の答え lt-ZDN45RSNPV16BKSM997GGZ9CVB — effect にする・card ki-1e51e218527e)。前の口の class Indexer(Indexer.for_module(m).find_symbols(…))と拡張の class SymbolInfo は内側の拡張 doeff_indexer._native に移し、入口から出さない。答えの 1 行の型 SymbolInfo は R2 の effect の結果の型として、入口で Python の frozen dataclass にして見せる(handler が拡張の答えを写す — test は自分の handler で SymbolInfo を作って FindSymbols に答えられる)。R12 のとおり、目録の道具が R2 の型を許す物と数えるまでは既知の表の「足した名」に置く。rust_indexer は設定も呼びごとの状態も無いので、工場でなく handler の値(ADR-DOE-API-002 R1)。effect と答えの型(doeff_indexer._effects)は拡張を読まず、拡張を読むのは handler(doeff_indexer._handlers)だけ — 拡張の .so 無しに effect を出して test の handler で答えられる。索引を作れない失敗は RuntimeError か OSError を FindSymbols を出した所へ投げ返し、doeff run の discovery は program の中(discover)でそれを受けて warning に出し、何も探さない(既定の interpreter へ落ちる)。doeff-indexer が入っていなければ discovery は黙って探さず、入っているのに拡張を読めなければ warning を出す(構成のレビュー lt-QHQJEWJDSAHGTT1ZASS28F9V68)。Python の口が替わったので版は 0.2.0。CLI コマンド doeff-indexer は R7 の人が打つ CLI として残し(中身は同梱の Rust の binary — IDE の plugin が呼ぶ)、既知の表の組「境界 — CLI」に置く。呼び手は doeff run の discovery(doeff/cli/discovery.py — FindSymbols を出す program discover を、doeff run が rust_indexer の下で回す)と docs-video の discover.py で、どちらも書き換えた。目録は Rust の拡張を持つ package を字面で読むと拡張から出す名を数えないので、doeff-indexer を root の dev の組に入れて import で読み、決まりの範囲の Rust の拡張を持つ package を import で読めなければ表の test が赤にする(R12)。doeff-indexer は範囲「決まりの範囲」へ移した。")
     (rule R28 "doeff-agentic-cli(workflow の一覧・監視・接続を答える Rust の CLI の package)は消し、その実行 file doeff-agentic を doeff-agentic の Python の CLI に寄せる(2026-10-29 23:46 JST・問い agentic-cli の答え lt-T9TTHBXF5YK0B1FBJGFCZF6CZ1 — 消して寄せる・card ki-626bf91b0560・ki-7b2e293a2db7)。Python の CLI(console script doeff-agentic・pip install doeff-agentic で入る)は、消した CLI と同じ 6 動詞(ps・show・watch・attach・send・stop)を同じ引数と JSON で答え、中身は記録と tmux を doeff-agentic の effect と handler で扱う program(R7 — handler を迂回して記録を直に読む口を残さない)。IDE の plugin 2 つ(VS Code の doeff-runner・neovim の doeff.nvim)は実行 file の名 doeff-agentic を呼んだまま、入れ方の案内を pip install doeff-agentic に替えた。package を消したので、既知の表からその package の行(範囲「範囲の答え待ち」・組「境界 — 基盤・道具の package」の (実行 file) doeff-agentic)を消し、R13 (b) から外した。console script doeff-agentic は doeff-agentic の「足した名」に在る(決め ki-626bf91b0560)。")
     (rule R29 "doeff-domain は範囲「決まりの範囲」に入れ、表に置く・引く・check する関数 8 個(register_domain・isolated_registry・get_domain・handles・handled_effects・assert_domain_covered・assert_registered_domains_covered・assert_no_orphan_effects)は、effect RegisterDomain・GetDomain・HandledEffects・AssertDomainCovered・AssertRegisteredDomainsCovered・AssertNoOrphanEffects と、表から答える handler を返す工場 domain_registry にした(2026-10-29 22:19 JST・依頼書 lt-71XZ9Z3RP0W3V2WFN3R7TW6SSV の問い domain の答え lt-FP17P0A4CPBC1RJCF9BFBVF4WV — effect にする・card ki-03a7f0af2b64・ADR-DOE-DOMAIN-001 R8)。呼び手は doeff の ADR-DOE-DOMAIN-001 と package の test だけだったので、移し替えの層を残さずに関数を消し、本体は内側の doeff_domain._registry・_checks・_introspect に置いた。domain_registry() は process の表(macro defdomain が import の時に載せる所)を答える時に読み、domain_registry(domains=[Domain …]) は渡した domain だけの別の表から答える — isolated_registry の代わりで、RegisterDomain もその表へ載せ、表に無い名は外の表へ落ちずに KeyError。別の表は工場を呼んだ時に 1 つ作り、同じ handler の値を使い回す間は RegisterDomain の載せが残る(test ごとに新しい表が要るなら工場を呼び直す)。domains の名の重なり・2 度目の導入は、program の中でなく工場を呼んだ時に例外になる。check の失敗は DomainError の子 — 走査で import できない module も DomainCheckError に包む(元の例外は __cause__)— で、表に無い名は KeyError。どちらも TransferThrow で effect を出した所へ投げ返す(構成のレビュー lt-65QDW3YV7ZMX3ZA9Q77QKCZPB6 の所見で、失敗の型を 2 つに絞った)。handles(handler の注釈)は、呼ぶと印の付いた handler を返す工場(R3)でも、effect を出すだけの program を返す helper(R18)でもない — handles(Ask) は印の無い関数を返し、import の時に他の package の handler に印を後付けする宣言だった。import の時の宣言は program の中で出す effect にできないので、R19 と同じく型にした: domain の handlers に Handles(handler, effect …) を置き、宣言は domain の側に在って handler に何も付けない。Handles は effect RegisterDomain の値 Domain の欄の値として R2 の型に数え、R12 のとおり、目録が R2 の型を許す物と数えるまでは既知の表の「足した名」に置く。宣言の型 Domain・DomainLaw・DomainTerm(R2 の effect の値の型)と例外 8 個(R2)は入口から見せ、macro defdomain は doeff_domain.macros から見せる — Hy の require が module の path で macro を読むので、R14・R15 と同じ訳で R5 の外の境界に置く。外が使わない名(clear_registry・domain_names・introducing_domain・registered_domains・定数 BODY_ATTRIBUTE と HANDLES_ATTRIBUTE)と submodule 4 個(checks・introspect・registry・core_effects_domains)は R1・R5 のとおり _ の付いた内側へ移した。")
     (rule R30 "doeff-adr の assert_adr_contract(ADR 1 つの形を確かめる関数)・assert_all_adr_contracts(載っている ADR の全部の形を確かめる関数)・register_deftest_enforcement(deftest の検を表に載せる関数)は、effect AssertAdrContract・AssertAllAdrContracts・RegisterDeftest にし、R20 の工場 adr_registry の同じ handler が答える(2026-10-30 01:09 JST・依頼書 lt-6SE07X4256P323ZGZVNSEF9M95 の問い adr-scope の答え lt-RA4FZ731JNZQ6JEGVAYD35XCAZ — doeff-adr の残りの名を R20〜R22 と同じ向きで直して内側へ隠す・card ki-54e559d3c0e7)。確かめは GetAdr と同じ ADR の表と検の表を読み、外の process を起こさないので、R22 の semgrep_enforcements でなく adr_registry に置く。adr_registry に引数 enforcements=(検の辞書)を足した: specs と enforcements のどちらも無ければ process の登録簿を答える時に読み、どちらかを渡せば別の登録簿で、ADR は specs の列だけ・検は enforcements の辞書だけから読む(渡さない方は空 — enforcements を渡さない時の空の辞書は工場を呼んだ時に作り、RegisterDeftest はそこへ載せる)。確かめの外れ(採用済みなのに検が無い・挙げた検が表に無い・expected-red の検が計画に結ばれない)は AssertionError、表に無い ADR の id は KeyError、載せの id の重なりと知らない mode は ValueError で、どれも TransferThrow で effect を出した所へ投げ返す。AssertAllAdrContracts は id の順に確かめ、最初の外れを投げる。本体は内側の registry._assert_adr_contract(ADR の値と検の表を受ける)・registry._register_deftest_enforcement(検の表を受ける)に置いた。外の repo の呼び手は 0(2026-10-30 の数え・~/repos の全 repo の既定の branch — 語が出るのは dotfiles の検の註と ADR の文だけ)なので、R29 と同じく移し替えの層を残さずに 3 つの関数を registry と入口から消し、既知の表の 6 行(doeff_adr と doeff_adr._registry の 3 名ずつ)も消した。macro defadr の展開は、:enforcement の中の deftest の載せを import の時に RegisterDeftest として、生まれる test(test_<ID>_adr_contract)の確かめを AssertAdrContract として、どちらも adr_registry() の下で走らせる — R22 の defsemgrep と同じく project の doeff_interpreter fixture に頼らないので、外の repo の defadr は doeff の版を上げるだけで動く。")
     (rule R31 "doeff-hy の外の Hy の macro の置き場と doeff-hy の道具の入口(R13 (c) の残り — 既知の表の 19 行)は、R14・R15・R7・R10・R16 と同じ向きで持ち主が問わずに決めた(2026-10-30・card ki-d80c9c978b35・出どころ card ki-88d0182205ca の問いの案 Q4)。macro を出す module doeff_conductor.macros(workflow の macro 13 個)・doeff_events.macros(event-loop)・doeff_domain.macros(defdomain)は、Hy の require が module の path で macro を読むので R14・R15 と同じく R5 の外の境界に置き、名に _ を付けない — 段 1(card ki-e8796f1e8ec6 ほか)が _macros へ隠して移し替えの module を置いた conductor と events の 2 つは、公開の module に戻した。macro を出す module の目録の名は Hy の macro だけにする。doeff-hy の CLI doeff-hy-check は R7 の CLI コマンドと同じく残す。doeff_hy.pytest_plugin は許さずに消した — 持ち主の決めの前提(install が pytest の plugin の登録)と違い、pytest11 の plugin の登録は doeff-hy-pytest が持ち(R10・2026-09-26 に移した)、この module を読む所は doeff と ~/repos の repo に 0 で、install は doeff_hy._ast_unparse の内側の関数だった(card ki-d80c9c978b35 の報告で持ち主へ返した)。doeff_docker.compose の macro with-handlers(handler の並びを入れ子の呼び出しに展開する)は、R16 の公式の形 h1(h2(p)) と別の当て方を利用者に見せるので消し、呼び手の doeff-ml-nexus の 2 か所を h1(h2(p)) に書き替えた。許す名は許した物の表の組「許した物 — Hy の macro」(目録の形が Hy の macro の名と、Hy の macro だけを出す公開の submodule の行)と「許した物 — CLI コマンド」(console script と Rust の実行 file の行)に決めの id つきで置き、表の test が組ごとに形を確かめる(R12)。")
     (rule R32 "doeff-adr の登録簿を読み書きする関数 4 個(register_adr・clear_registry・enforcement_ids・get_enforcement)は、effect RegisterAdr(ADR を載せる → AdrSpec)・ClearRegistry(ADR と検を空にする → None)・EnforcementIds(検の id の一覧 → list[str])・GetEnforcement(id で検を引く → EnforcementRef か SemgrepSpec)にし、R20 の工場 adr_registry の同じ handler が答える(2026-10-30 01:09 JST・依頼書 lt-6SE07X4256P323ZGZVNSEF9M95 の問い adr-scope の答え lt-RA4FZ731JNZQ6JEGVAYD35XCAZ — doeff-adr を範囲に入れ、残りの名を R20〜R22 と同じ向きで直す・card ki-dab8943cf664)。外の repo(agora-controllers・agora・custody ほか)に呼び手が無かったので、移し替えの層を残さずに 4 個を registry と入口から消し、本体は内側の registry._register_adr・_clear_registry・_enforcement_ids・_get_enforcement(どれも表を引数で受け、None = process の登録簿)に置いた。既知の表の 8 行(doeff_adr と doeff_adr._registry の 4 名ずつ)も消した。別の登録簿は R30 の引数 enforcements と同じ形で、ADR の表は specs の写し(工場を呼んだ時に 1 つ作り、RegisterAdr はそこへ載せる)・検の表は渡した辞書そのもの — semgrep_enforcements(table=…) と同じ辞書を渡せば、RegisterSemgrep の載せを GetEnforcement と RegisterAdr の検の id が読む。4 つの effect は別の登録簿から外へ落ちず(無い id は KeyError)、ClearRegistry は別の登録簿の 2 つの表だけを空にする。載せと引きの決まった失敗(KeyError・TypeError・ValueError)は TransferThrow で effect を出した所へ投げ返す。macro defadr の展開は、ADR の載せも import の時に effect RegisterAdr として adr_registry() の下で走らせる(R30 の RegisterDeftest と同じ形)。effect だけで読み書きする test は、別の登録簿を据えた handler で足り、registry.isolated_registry が要らない。isolated_registry は、macro の展開が import の時に process の登録簿へ載せる所を試す test だけが使う内側の道具として registry に残す(展開は handler を自分で据えるので、外から差し替えられない — 隠すのは submodule を _ へ移す card ki-cb4daa2ddbcb)。")
     (rule R33 "doeff-adr(実行できる ADR の macro と pytest の plugin の package)は範囲「決まりの範囲」に入れ、R1・R5 をほかの package と同じく当てる(2026-10-30 01:09 JST・依頼書 lt-6SE07X4256P323ZGZVNSEF9M95 の問い adr-scope の答え lt-RA4FZ731JNZQ6JEGVAYD35XCAZ — 範囲に入れる・card ki-ae23c91f6e75)。公開の名は effect と handler(R20・R21・R22・R30・R32)と、R2 の型・CLI コマンド doeff-adr(R7)・pytest11 の plugin の登録・macro を出す module doeff_adr.macros(R14・R31 と同じ向き)だけにする。submodule 12 個は _ へ移し(card ki-cb4daa2ddbcb — doeff 64ac67a2a)、外の repo の古い path の呼び手 5 か所(agora-controllers と jev-proxy)を入口と doeff_adr.macros へ書き換えた後(card ki-554181c45605)に、移し替えの module 12 個を消した(tools/hide_submodules.py finish)。既知の表の doeff-adr の外れの組の行(submodule を _ で隠す 12・内側の module へ移す 174)と、入口の行と重なる境界の行 3 つを消し、範囲を「決まりの範囲」に改めた。残る境界の行(型・CLI・pytest の plugin の登録・Hy の macro)は、許した物の表へ移す card(ki-03aa4c49f7e0・ki-5401da404e8e・ki-17fb02cf904b・ki-93b21540e519・ki-a07d4703a73b)が移す。R13 (b) から外した。")]
  :laws
    [(law subpackage-shows-only-effects-and-handlers
       :statement "for_all package p under packages/ with scope(p) = 決まりの範囲: outside(p) = {n in public_names(p) | kind(n) not in {effect, handler}} = known(p) + allowed(p) with known(p) and allowed(p) disjoint, listed_names(table) only shrinks from its first version, and the known table holds no allowed group"
       :counterexamples
         [(counterexample "doeff_agents の根が launch_session を出し、tutorial がそれで session を手で起こす(この ADR の発端の形)")
          (counterexample "subpackage の根に新しい helper 関数を足し、既知の表にも「足した名」にも書かずに通る")
          (counterexample "外れを直したのに既知の表に名を残し、表が縮まない")
          (counterexample "既知の表の「名」の組に新しい名を書き足して、足した外れを通す")
          (counterexample "Rust の拡張を持つ package を環境に入れず、目録が字面で読んで、入口が拡張から出す名(前の doeff-indexer の Indexer)を数えずに通る")]
       :enforced-by ["tests/test_public_api_known_violations.py::test_public_api_outside_effects_and_handlers_is_in_the_known_table"
                     "tests/test_public_api_known_violations.py::test_an_added_outlier_turns_red_and_removing_it_turns_green"
                     "tests/test_public_api_known_violations.py::test_a_fixed_name_left_in_the_table_turns_red"
                     "tests/test_public_api_known_violations.py::test_a_native_package_in_scope_that_the_inventory_cannot_import_turns_red"
                     "tests/test_public_api_known_violations.py::test_the_known_table_only_shrinks_from_its_first_version"
                     "tests/test_public_api_known_violations.py::test_a_name_put_into_the_listed_groups_turns_red"
                     "docs/adr/defadr_doeff_api_001_subpackages_show_effects_and_handlers.hy::test-adr-doe-api-001-an-added-outlier-turns-the-guard-red"
                     "docs/adr/defadr_doeff_api_001_subpackages_show_effects_and_handlers.hy::test-adr-doe-api-001-the-known-table-is-well-formed-and-only-shrinks"]
       :wiring "配線済み(2026-10-26・card ki-aaaa56621c5a)— package ごとの 39 件・使い捨ての package の赤と緑・表の形・減るだけ。この file の deftest はその関数を呼ぶだけ")
     (law a-handler-is-a-marked-value-and-a-factory-returns-one
       :statement "handler(h) <=> marked(h) (h: ProgramHandler); factory(f) <=> for the arguments f needs at least (none when every parameter has a default): marked(f()) or f() is a list or tuple of marked values; counted_as_factory(f) and callable_without_arguments(f) and not factory(f) => outside(f); takes(f, Program) and returns(f, Program) and not marked(f) => not handler(f); class c named *Handler => not handler(c)"
       :counterexamples
         [(counterexample "2026-10-29 より前の maybe(p) のように program を受けて program を返す印の無い関数を、形が program -> program だから handler と数えて許す")
          (counterexample "戻りの型を ProgramHandler と書いた関数が、呼ぶと program を素通しする印の無い関数を返すのに、戻りの型だけで handler を返す工場と数えられて表の外で通る")
          (counterexample "名が Handler で終わる class を、method で effect を受けるから handler と数えて公開する")]
       :enforced-by ["tests/test_public_api_inventory.py::test_names_are_typed_by_marker_return_type_and_return_shape"
                     "tests/test_public_api_inventory.py::test_a_factory_says_whether_its_call_was_checked"
                     "tests/test_public_api_inventory.py::test_a_factory_is_called_with_home_and_cwd_in_a_scratch_dir"
                     "tests/test_public_api_known_violations.py::test_a_factory_whose_call_is_not_a_handler_turns_red"
                     "tests/test_public_api_known_violations.py::test_public_api_outside_effects_and_handlers_is_in_the_known_table"
                     "docs/adr/defadr_doeff_api_001_subpackages_show_effects_and_handlers.hy::test-adr-doe-api-001-a-factory-whose-call-is-not-a-handler-turns-the-guard-red"]
       :wiring "一部配線(2026-10-29・card ki-25eecd63bc57)— 目録は印で handler を数え、印の無い Handler の名の class を未分類、(effect, k) の関数を handler と読む。戻りの型か return の形で工場と読めた関数は、最小の引数(無いか、既定値の無い引数ごとに置き物)で呼んで(HOME・XDG の dir・cwd を一時の dir へ向けて)印を確かめ、印の無い値を返せば外れ「handler を返さない関数」と数えるので、既知の表に無ければ赤。呼ぶと例外の出る工場は戻りの型の読みのまま(行の理由に例外を書く — 2026-10-29 の目録で 225 個のうち 21 個)。import の時に module が決めた書き先は一時の dir へ向かない。この file の deftest はその関数を呼ぶだけ")
     (law the-public-names-come-from-the-import-root
       :statement "for_all package p in scope: for_all public submodule m of p: m's path has a part starting with _ — enforced as: public_submodules(p) = known_submodules(p), known_submodules only shrinks from the version that added them, and a name n moved from a submodule s to the import root r is the same row as (s, n) when s no longer shows n or shows the same definition"
       :counterexamples
         [(counterexample "effect を doeff_agentic.effects から import させ、根と submodule の 2 つの口で同じ名を見せる")
          (counterexample "subpackage に _ の無い submodule を新しく足し、出す名が effect だけなので既知の表にも「足した名」にも書かずに通る")
          (counterexample "R2 の型を submodule から入口へ移すと、表の鍵(名を出す module)が替わったと読まれて赤になり、直しが表の名の組を書き足すか「足した名」に書くしか無い")
          (counterexample "submodule がまだ出している名と同じ名の、違う定義を入口に足し、入口へ移した名と読まれて通る")]
       :enforced-by ["tests/test_public_api_known_violations.py::test_public_api_outside_effects_and_handlers_is_in_the_known_table"
                     "tests/test_public_api_known_violations.py::test_an_added_public_submodule_turns_red_and_hiding_it_turns_green"
                     "tests/test_public_api_known_violations.py::test_moving_names_from_a_submodule_to_the_root_keeps_the_table_green"
                     "tests/test_public_api_known_violations.py::test_a_different_definition_with_a_known_name_at_the_root_turns_red"
                     "tests/test_public_api_known_violations.py::test_a_marked_shim_keeps_the_modules_below_a_moved_package_at_their_old_names"
                     "tests/test_public_api_known_violations.py::test_the_known_table_only_shrinks_from_its_first_version"
                     "tests/test_public_api_known_violations.py::test_a_submodule_row_put_into_the_table_after_it_had_submodule_rows_turns_red"
                     "docs/adr/defadr_doeff_api_001_subpackages_show_effects_and_handlers.hy::test-adr-doe-api-001-a-public-submodule-turns-the-guard-red-and-a-moved-name-does-not"]
       :wiring "配線済み(2026-10-28・card ki-25d43146681e)— 目録は _ で始まらない submodule を 1 行(名を出す module の欄が (submodule))の外れと数え、既知の表は今の公開の submodule 731 行を載せて、submodule の行を足した版から減るだけ。名を submodule から入口へ移した行は表の module を書き換えずに同じ行と読む(submodule がまだ同じ名を出す間は定義の場所が同じ時だけ・古い口を閉じた後は名と根だけ)。1 行目に印 # moved-submodule-shim: <古い名> -> <新しい名> の在る移し替えの module(card ki-299be2ea4a13 の道具が置く)は、移した先の package の下の module も古い名で数えるので、stage 1 は表を書き換えずに緑。隠した submodule の行は表から消す。この file の deftest はその関数を呼ぶだけ")
     (law an-allowed-program-helper-only-emits-effects
       :statement "for_all package p in scope: for_all (m, n) in allowed(p, 許した物 — program の helper): returns_program(n) and for_all body b in bodies(n): not reads(b, handler_control) and not reads(b, handler_installer) — bodies(n) = n and the functions of p that n reads, followed through; handler_control = {Resume, ResumeThrow, Transfer, TransferThrow, Pass}; handler_installer = WithHandler or a marked value or a handler builder or a factory; an allowed group is a group whose names the inventory checks; and every row of the allowed table names its decision (a card, request or remark id)"
       :counterexamples
         [(counterexample "program を受けて handler の値を当てて返す関数(maybe の今の形)を、program を返すから helper の組に置いて通す")
          (counterexample "helper の組に置いた関数の中で、同じ package の別の関数が WithHandler で handler を被せるのに、組の名の中だけを読んで通す")
          (counterexample "中で Resume を出して effect に答える関数を helper と数える")
          (counterexample "program を返さない関数(check のように指定の値を返す物)を helper の組に置いて通す")
          (counterexample "形を確かめない許した物の組(例 許した物 — 便利な関数)を表に作り、外れの名をそこへ移して通す")
          (counterexample "後から見せる関数を「足した名」に helper として書き、組の確かめを受けずに handler を被せる関数を通す")
          (counterexample "決めの id の無い行を許した物の表に足して、誰も許していない名を通す")
          (counterexample "許した物の組を既知の表に残し、外れと境界を直し切っても既知の表が空にならない")]
       :enforced-by ["tests/test_public_api_known_violations.py::test_only_a_program_helper_can_be_put_into_the_helper_group"
                     "tests/test_public_api_known_violations.py::test_an_allowed_group_without_a_check_is_not_well_formed"
                     "tests/test_public_api_known_violations.py::test_an_allowed_row_without_a_decision_id_is_not_well_formed"
                     "tests/test_public_api_known_violations.py::test_the_allowed_table_is_well_formed"
                     "tests/test_hide_submodules.py::test_a_name_in_the_allowed_table_goes_to_the_entry_and_finish_drops_its_row"
                     "tests/test_public_api_inventory.py::test_what_the_helper_reading_does_not_see"
