+        (for [e old]
+          (val parts (.split e.name "/"))
+          (when (and (= e.kind PathKind.FILE) (.endswith e.name ".pyc") (>= (len parts) 2)
+                     (= (get parts -2) PYCACHE-DIR) (not-in ".venv" parts))
+            (val base (.join "/" (cut parts 0 -2)))
+            (val stem (get (.split (get parts -1) ".") 0))
+            (when (any (gfor s BYTECODE-SOURCE-SUFFIXES (in (posixpath.join base (+ stem s)) present)))
+              (<- (MakeDirectory (posixpath.join dest base PYCACHE-DIR)))
+              (<- linked (| None FileFailed) (LinkFile (posixpath.join source e.name) (posixpath.join dest e.name)))
+              (match linked
+                (FileFailed) None
+                _ (:= placed (+ placed 1))))))
+        placed)
+    _ 0))
