@@ -220,6 +222,24 @@
   None)
 
 
+;; 照合を済ませた handle の節の関数の code。handle は評価のたびに handler の本体(data)を作り直すので、済んだ印を
+;; data ではなく節の関数の code(書いた場所ごとに 1 つ)に置く。code を弱く持つ(module を捨てれば消える)。
+(setv _CHECKED-HANDLE-CODES (weakref.WeakSet))
+
+
+(deff check-clause-endings-per-site [data handler specs]  ; defk にできない: 展開した handle が評価の時に呼ぶ検め(effect を出さない)
+  {:pre [(: data Callable) (: handler str) (: specs Callable)] :post [(: % None)]
+   :tags {:context "doeff-hy-handler" :role "foundation"}}
+  "関数の中の handle の節の終わり方の照合を、書いた場所ごとに 1 回だけ行うため — 関数の中の handle は外の関数を呼ぶ
+   たびに評価され、照合(resumption-of と match)が評価ごとに走っていた。defhandler の check-clause-endings-once と同じ
+   考え方で、印を data の関数の code に置く。"
+  (let [code (. (inspect.unwrap data) __code__)]
+    (when (not-in code _CHECKED-HANDLE-CODES)
+      (check-clause-endings handler (specs))
+      (.add _CHECKED-HANDLE-CODES code)))
+  None)
+
+
 (deff fell-through [handler effect-label]  ; defk にできない: 展開した handler の節が実行の時に呼ぶ(例外を作るだけ)
   {:pre [(: handler str) (: effect-label str)] :post [(: % RuntimeError)]
    :tags {:context "doeff-hy-handler" :role "foundation"}}
