+(defn _throw [args recur]
+  "実験: (throw 例外) → 続きへ例外を投げ、続きが終わったら節へ戻る(resume と同じく handler は残る)。"
+  `(do (setv _doeff_resumed_value (yield (ResumeThrow k ~(recur (get args 0)))))
+       (setv _doeff_clause_resumed True)
+       _doeff_resumed_value))
+
+
+(defn _transfer-throw [args recur]
+  "実験: (transfer-throw 例外) → 続きへ例外を投げ、handler を外す(末尾)。"
+  `(yield (TransferThrow k ~(recur (get args 0)))))
+
+
