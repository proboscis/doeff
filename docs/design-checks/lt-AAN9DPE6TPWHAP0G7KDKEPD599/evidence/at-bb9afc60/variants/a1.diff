+    def wake_some_waiter(some_state, completed_key):
+        if some_state["resolved"]:
+            return None
+        status, result = waitable_status(completed_key)
+        if status not in terminal_statuses:
+            return None
+        if status != "completed":
+            some_state["resolved"] = True
+            remove_some_waiters(some_state)
+            err = result if status == "failed" else TaskCancelledError()
+            return enqueue_raise(some_state["owner_tid"], some_state["waiter_k"], err)
+        some_state["done"].append((some_state["keys"].index(completed_key), result))
+        if len(some_state["done"]) < some_state["count"]:
+            return None
+        some_state["resolved"] = True
+        remove_some_waiters(some_state)
+        return enqueue_resume(some_state["owner_tid"], some_state["waiter_k"], list(some_state["done"]))
