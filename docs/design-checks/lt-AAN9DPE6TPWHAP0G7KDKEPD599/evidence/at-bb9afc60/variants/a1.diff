+class WaitSome(EffectBase[list[Any]]):
+    """EXPERIMENT (blind-a, S2): wait until ``count`` of the Tasks/Futures complete.
+
+    Resolves with ``[(index, value), ...]`` in completion order; the first
+    failure/cancel raises (fail-fast, like Gather). Same park modes as Race.
+    """
+
+    def __init__(self, count: int, *tasks: "Task[Any] | Future[Any]", priority: int | None = None) -> None:
+        super().__init__()
+        self.count = count
+        self.tasks = tasks
+        self.priority = priority
+
+
+class Reschedule(EffectBase[None]):
+    """EXPERIMENT (blind-a, S3): requeue the current task at ``priority`` (and keep that priority)."""
+
+    def __init__(self, priority: int) -> None:
+        super().__init__()
+        self.priority = priority
+
