        from hy.compiler import hy_compile
        from hy.models import Expression, Integer, List, Symbol
    
        for base, mangled in (("bound", "bound"), ("el-begin", "el_begin"), ("", "")):
            name = str(hy.gensym(base))
            match = records.GENSYM_NAME.fullmatch(name)
