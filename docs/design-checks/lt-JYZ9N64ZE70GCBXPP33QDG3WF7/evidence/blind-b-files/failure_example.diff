+def test_a_macro_required_inside_a_function_is_recorded(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """関数の中の require で入れた macro も、展開が使った macro として記録に入る。Hy の展開は関数の中の局所の macro の表
+    (compiler の局所の状態)を module の表より先に引くので、module の表を替えるだけでは記録から漏れ、macro を変えても使う側が
+    古い展開のまま動いた(包みは compiler が局所の状態を開く口で、その表を記録の表に覚えさせる)。"""
+    import hy
+
+    from doeff_hy_bytecode_guard import source_to_code_as_import
+
+    package = tmp_path / "localpkg"
+    package.mkdir()
+    (package / "__init__.py").write_text("")
+    (package / "macros.hy").write_text("(defmacro answer [] 11)\n")
+    source = package / "user.hy"
+    source.write_text("(defn f [] (require localpkg.macros [answer]) (answer))\n(setv value (f))\n")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    name = "localpkg.user"
+    try:
+        importlib.import_module("localpkg.macros")
+        loader = importlib.machinery.SourceFileLoader(name, str(source))
+        record = records.record_of(source_to_code_as_import(loader, source.read_bytes(), str(source)))
+        assert record is not None
+        assert [(used.module, used.name) for used in record.macros] == [("localpkg.macros", "answer")], (
+            f"Hy {hy.__version__}: 関数の中の require で使った macro が記録に無い: {record}"
+        )
+    finally:
+        for loaded in (name, "localpkg.macros", "localpkg"):
+            sys.modules.pop(loaded, None)
+
+
