+(defk node-seat-env-digest-of [pairs]
+  {:pre [(: pairs tuple)]
+   :post [(: % str)]}
+  "PROTOTYPE: 機体が席へ渡す env の指紋。"
+  (setv canonical (json.dumps (lfor #(n v) pairs [n v]) :ensure-ascii False :separators #("," ":")))
+  (.hexdigest (hashlib.sha256 (.encode canonical "utf-8"))))
