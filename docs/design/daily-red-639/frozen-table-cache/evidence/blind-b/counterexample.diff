diff --color -ru /Users/kento/.worktrees/doeff-wt-639-P-blind/packages/doeff-agents/tests/sessionhost_cache_maintenance_deftests.hy /tmp/blind-p-cx/wt/packages/doeff-agents/tests/sessionhost_cache_maintenance_deftests.hy
--- /Users/kento/.worktrees/doeff-wt-639-P-blind/packages/doeff-agents/tests/sessionhost_cache_maintenance_deftests.hy	2026-09-26 07:57:04
+++ /tmp/blind-p-cx/wt/packages/doeff-agents/tests/sessionhost_cache_maintenance_deftests.hy	2026-09-26 08:09:44
@@ -216,3 +216,23 @@
   (<- expired tuple (sessions-to-retire #(view) 10200000 600))
   (assert (= expired #("resident")))
   (assert (= view.turn-ended-at-ms 0)))
+
+;; 失敗した専用操作の理由に子の stderr の尾が載ること(診断)。memory の置き場は stderr の流れを
+;; since で返さないので、stderr を locator + ".stderr" に置く package の file の置き場を組む。
+(import tempfile)
+(import doeff_agents.sessionhost.headless_events [FileEventStore])
+
+(deftest test-failed-ping-reason-carries-the-provider-stderr-tail
+  (setv root (tempfile.mkdtemp :prefix "cache-stderr-")
+        store (FileEventStore)
+        hosted (headless-substrate (HeadlessRegistry store))
+        state {"now" 3300000 "receipts" []}
+        at "1970-01-01T00:55:00+00:00"
+        locator f"{root}/resident.events.jsonl.cache-ping-err")
+  (.append store (HeadlessEventAppend locator "stdout" (json.dumps {"type" "result" "is_error" True}) at))
+  (.append store (HeadlessEventAppend locator "stderr" "API Error: 529 overloaded" at))
+  (setv pending (HostCacheRecord "ping-err" "resident" 3600000 "process" locator
+                  :state MaintenanceState.RUNNING :started-at 3300000))
+  (<- failed HostCacheRecord (hosted ((residency-world state) (cache-host-probe pending))))
+  (assert (= failed.state MaintenanceState.FAILED))
+  (assert (= failed.reason "provider-error: API Error: 529 overloaded")))
