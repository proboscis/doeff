+def _watchdog_kill(config, timeout: int, nodeid: str):
+    """Last resort: end the process if a test hangs beyond all timeouts."""
+    try:
+        # The test's output is being captured; the line must reach the terminal
+        # (the same steps as pytest-timeout's thread method).
+        capman = config.pluginmanager.getplugin("capturemanager") if config else None
+        if capman is not None:
+            capman.suspend_global_capture(in_=True)
+        terminal = config.get_terminal_writer() if config else None
+        text = (
+            f"FAILED {nodeid} - WATCHDOG: no progress for {timeout}s beyond all timeouts; "
+            f"the process was ended and the tests after it did not run"
+        )
