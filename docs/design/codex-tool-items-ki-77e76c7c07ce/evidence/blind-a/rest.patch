+  (<- read (run-on STUB tmp-path background-turns))
+  (val first (get read "first"))
+  (val second (get read "second"))
+  (val events (+ first.events second.events))
+  (<- uses (of-kind events AgentToolUseEvent))
+  (<- results (of-kind events AgentToolResultEvent))
+  (val called (tuple (gfor use uses call use.tool-calls call.id)))
+  (val answered (tuple (gfor result results answer result.answers answer.id)))
+  (assert (and (= called #("call_bg")) (= answered #("call_bg")))
+          {"called" called "answered" answered "T1 end" (type first.end) "T2 end" (type second.end)
+           "kinds" (tuple (gfor event events (. (type event) __name__)))}))
