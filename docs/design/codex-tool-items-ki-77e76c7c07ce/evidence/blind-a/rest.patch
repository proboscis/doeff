+;; --- 実験(ki77e7-blind-A — 共有しない): 本物の codex 0.162.1 で録った命令の出力の途中(item/commandExecution/outputDelta)と、
+;; 後ろで走り続けた命令の終わりが、handler のどのターンの列へ積まれるか ---
+(import doeff_codex.lines [Response ItemDone TurnEnded CommandOutputDelta])
+(import doeff_codex.handler [SessionRuntime absorb])
+(import doeff_codex.values [CodexSessionSpec CodexHome])
+
+
+(defk replayed [#^ str name #^ bool prompt]
+  {:pre [(: name str) (: prompt bool)] :post [(: % SessionRuntime)] :tags {:context "codex-test" :role "foundation"}}
+  "録った行を順に分類して absorb し、会話の状態を返すため。prompt = turn/start の答えを積んだ直後に current-turn を置く(handler の
+   節が窓なく追いつく時)/ 偽 = 録りの全部を積み終えるまで置かない(替え玉が答えの直後に一気に流し、読み手の thread が先に進む時)。"
+  (<- records (recorded-records name))
+  (val runtime (SessionRuntime (CodexSessionSpec :home (CodexHome :env {}) :cwd "/w")))
+  (for [record records]
+    (<- (absorb runtime record))
+    (when (and prompt (isinstance record Response) (is-not record.turn-id None))
+      (setv runtime.current-turn record.turn-id)))
+  runtime)
+
+
+(defk placement [#^ SessionRuntime runtime]
+  {:pre [(: runtime SessionRuntime)] :post [(: % tuple)] :tags {:context "codex-test" :role "foundation"}}
+  "出力の途中と命令の item の終わりが、どの列(ターンの番号 T1・T2 か outside)に、そのターンの終わりの前か後に積まれたか。"
+  (val names (dfor #(index turn-id) (enumerate runtime.turns) turn-id f"T{(+ index 1)}"))
+  (val placed [])
+  (var ended False)
+  (for [#(turn-id log) (.items runtime.turns)]
+    (:= ended False)
+    (for [event log.events]
+      (when (isinstance event.record TurnEnded) (:= ended True))
+      (when (or (isinstance event.record CommandOutputDelta)
+                (and (isinstance event.record ItemDone) (= event.record.item-type "commandExecution")))
+        (.append placed #((. (type event.record) __name__) event.record.item-id (get names event.record.turn-id) "in"
+                          (get names turn-id) (if ended "after-end" "before-end"))))))
+  (for [outside runtime.outside]
+    (when (isinstance outside CommandOutputDelta)
+      (.append placed #((. (type outside) __name__) outside.item-id (.get names outside.turn-id outside.turn-id) "in" "outside" ""))))
+  (tuple placed))
+
+
+(deftest test-ki77e7-c-where-output-deltas-and-late-command-ends-land
+  (<- slow-prompt (replayed "slow-command" True))
+  (<- slow-window (replayed "slow-command" False))
+  (<- bg-prompt (replayed "background-command" True))
+  (<- p1 (placement slow-prompt))
+  (<- p2 (placement slow-window))
+  (<- p3 (placement bg-prompt))
+  (assert False {"slow-command/current-turn-set" p1 "slow-command/window" p2 "background-command/current-turn-set" p3}))
