diff --git a/packages/doeff-codex/tests/test_tool_items.hy b/packages/doeff-codex/tests/test_tool_items.hy
index 4357b281c..020e21a91 100644
--- a/packages/doeff-codex/tests/test_tool_items.hy
+++ b/packages/doeff-codex/tests/test_tool_items.hy
@@ -95,3 +95,65 @@
   (assert (isinstance unparsed Unparsed) unparsed)
   (assert (= unparsed.method "item/started") unparsed)
   (assert (in "command" unparsed.reason) unparsed))
+
+
+;; --- 実験(ki77e7-blind-A — 共有しない): ターンを名乗る新しい記録(turn/plan/updated)を、turn/start の答えの直後に読んだ時の積み先 ---
+(import doeff_codex.lines [TurnStarted TurnEnded TurnStatus PlanUpdated])
+(import doeff_codex.handler [SessionRuntime absorb])
+(import doeff_codex.values [CodexSessionSpec CodexHome])
+
+
+(defk plan-line [#^ str turn-id]
+  {:pre [(: turn-id str)] :post [(: % str)] :tags {:context "codex-test" :role "foundation"}}
+  "turn/plan/updated の 1 行(形は codex 0.162.1 の app-server の schema の TurnPlanUpdatedNotification)。"
+  (json.dumps {"method" "turn/plan/updated"
+               "params" {"threadId" "thread-1" "turnId" turn-id "explanation" None
+                         "plan" [{"step" "read the code" "status" "inProgress"} {"step" "fix" "status" "pending"}]}}))
+
+
+(defk kinds-of [#^ SessionRuntime runtime #^ str turn-id]
+  {:pre [(: runtime SessionRuntime) (: turn-id str)] :post [(: % tuple)] :tags {:context "codex-test" :role "foundation"}}
+  "ターンの列に積まれた記録の型の名(順)。"
+  (tuple (gfor event (. (get runtime.turns turn-id) events) (. (type event.record) __name__))))
+
+
+(deftest test-ki77e7-a-plan-update-read-before-current-turn-is-set-lands-in-the-turn-it-names
+  ;; S3 の窓: 読み手の thread が turn/start の答えを積んだ後、handler の節が current-turn を置く前に、そのターンを名乗る行を読む。
+  (<- line (plan-line "turn-1"))
+  (<- plan (classify-line line))
+  (assert (and (isinstance plan PlanUpdated) (= plan.turn-id "turn-1")) plan)
+  (<- item-line (command-item-line "item/started" {"type" "commandExecution" "id" "call_1" "command" "ls" "cwd" "/w"
+                                                   "status" "inProgress" "commandActions" []}))
+  (<- item (classify-line item-line))
+  ;; 1 つ目のターン(current-turn は None)。
+  (val first (SessionRuntime (CodexSessionSpec :home (CodexHome :env {}) :cwd "/w")))
+  (<- (absorb first (TurnStarted :thread-id "thread-1" :turn-id "turn-1")))
+  (<- (absorb first plan))
+  (<- (absorb first item))
+  (<- first-kinds (kinds-of first "turn-1"))
+  ;; 2 つ目のターン(current-turn は終わった前のターン turn-0)。
+  (val second (SessionRuntime (CodexSessionSpec :home (CodexHome :env {}) :cwd "/w")))
+  (<- (absorb second (TurnStarted :thread-id "thread-1" :turn-id "turn-0")))
+  (<- (absorb second (TurnEnded :thread-id "thread-1" :turn-id "turn-0" :status TurnStatus.COMPLETED)))
+  (setv second.current-turn "turn-0")
+  (<- (absorb second (TurnStarted :thread-id "thread-1" :turn-id "turn-1")))
+  (<- (absorb second plan))
+  (<- (absorb second item))
+  (<- second-kinds (kinds-of second "turn-1"))
+  (<- second-old (kinds-of second "turn-0"))
+  (assert (= #(first-kinds second-kinds)
+             #(#("TurnStarted" "PlanUpdated" "ItemStarted") #("TurnStarted" "PlanUpdated" "ItemStarted")))
+          {"first" first-kinds "first.outside" first.outside "second" second-kinds "second.outside" second.outside
+           "second.turn-0" second-old}))
+
+
+(deftest test-ki77e7-b-plan-update-read-after-current-turn-is-set-lands-in-the-running-turn
+  ;; 比べ: current-turn が置かれた後に読めば、同じ行は走っているターンの列へ積まれる(名乗りではなく「走っている」で選ばれても同じ)。
+  (<- line (plan-line "turn-1"))
+  (<- plan (classify-line line))
+  (val runtime (SessionRuntime (CodexSessionSpec :home (CodexHome :env {}) :cwd "/w")))
+  (<- (absorb runtime (TurnStarted :thread-id "thread-1" :turn-id "turn-1")))
+  (setv runtime.current-turn "turn-1")
+  (<- (absorb runtime plan))
+  (<- kinds (kinds-of runtime "turn-1"))
+  (assert (= kinds #("TurnStarted" "PlanUpdated")) #(kinds runtime.outside)))
