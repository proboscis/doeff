+(deftest test-headless-codex-mcp-tool-items-reach-tool-use-and-tool-result-events
+  ;; MCP の道具の item(mcpToolCall)も、ほかの道具と同じ出来事で届く — 名は item の種類の名、input は server・tool・arguments、
+  ;; 結果は text の block を連ねた文、誤りの印は状態が completed でない時。
+  (val at (datetime 2026 10 11))
+  (val base {"type" "mcpToolCall" "id" "mcp_1" "server" "docs" "tool" "search" "arguments" {"q" "doeff"}})
+  (<- started-line (mcp-line "item/started" (| base {"status" "inProgress" "result" None "error" None})))
+  (<- started (classify-line started-line))
+  (<- uses (events-of started at 0 None))
+  (assert (= (len uses) 1) uses)
+  (val call (get (. (get uses 0) tool-calls) 0))
+  (assert (isinstance (get uses 0) AgentToolUseEvent) uses)
+  (assert (= #(call.id call.name) #("mcp_1" "mcpToolCall")) call)
+  (assert (= (get call.input "server") "docs") call.input)
+  (assert (= (get call.input "tool") "search") call.input)
+  (assert (= (get (get call.input "arguments") "q") "doeff") call.input)
+  (<- done-line (mcp-line "item/completed" (| base {"status" "completed" "error" None
+                                                    "result" {"content" [{"type" "text" "text" "found 3"}]}})))
+  (<- done (classify-line done-line))
+  (<- results (events-of done at 1 None))
+  (val answer (get (. (get results 0) answers) 0))
+  (assert (isinstance (get results 0) AgentToolResultEvent) results)
+  (assert (= #(answer.id answer.text answer.is-error) #("mcp_1" "found 3" False)) answer)
+  (<- failed-line (mcp-line "item/completed" (| base {"status" "failed" "result" None
+                                                      "error" {"message" "server docs is down"}})))
+  (<- failed (classify-line failed-line))
+  (<- failures (events-of failed at 2 None))
+  (val failure (get (. (get failures 0) answers) 0))
+  (assert (= #(failure.text failure.is-error) #("server docs is down" True)) failure))
